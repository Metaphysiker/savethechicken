@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Contacts
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Addresses
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@inject IStringLocalizer<AppResources> L

@code {
    [Parameter, EditorRequired] public PersonDto Person { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    protected override void OnInitialized()
    {
        if (Person.Contact == null)
        {
            Person.Contact = new ContactDto();
        }
        if (Person.Address == null)
        {
            Person.Address = new AddressDto();
        }
    }
}

<MudPaper Class="pa-4 my-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-4">Person Information</MudText>

    <MudSwitch @bind-Value="Person.IsBlacklisted"
               Label="Blacklisted"
               Color="Color.Error"
               Disabled="@IsReadOnly"
               data-testid="person-blacklisted"
               Class="mb-4" />

    @if (Person.IsBlacklisted)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @L["Blacklisted_Warning"]
        </MudAlert>
    }

    <MudSwitch @bind-Value="Person.IsDriver"
               Label="@L["IsDriver"]"
               Color="Color.Info"
               Disabled="@IsReadOnly"
               data-testid="person-is-driver"
               Class="mb-4" />

    <MudTextField @bind-Value="Person.Comment"
                  Label="@L["Comment"]"
                  Lines="3"
                  Variant="Variant.Outlined"
                  ReadOnly="@IsReadOnly"
                  data-testid="person-comment"
                  Class="mb-4" />
</MudPaper>

<ContactForm Contact="Person.Contact" IsReadOnly="@IsReadOnly" />
<AddressForm Address="Person.Address" IsReadOnly="@IsReadOnly" />
