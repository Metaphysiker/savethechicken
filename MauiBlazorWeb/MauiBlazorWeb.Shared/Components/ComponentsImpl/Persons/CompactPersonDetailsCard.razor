@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using Microsoft.Extensions.Localization
@using MauiBlazorWeb.Shared.Resources.Strings
@inject GenericDtoServiceFactory DtoServiceFactory
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppResources> L

@if (displayPerson != null)
{
    <MudPaper Class="pa-3 my-2" Elevation="1">
        <div style="display: flex; justify-content: space-between; align-items: start;">
            <div style="flex: 1;">
                @* Name *@
                @if (displayPerson.Contact != null && (!string.IsNullOrWhiteSpace(displayPerson.Contact.FirstName) || !string.IsNullOrWhiteSpace(displayPerson.Contact.LastName)))
                {
                    var currentName = GetFullName(displayPerson.Contact);
                    var comparisonName = GetFullName(ComparisonPerson?.Contact);
                    var isDifferent = IsDifferent(currentName, comparisonName);

                    <MudText Typo="Typo.subtitle1" Class="mb-1" Style="@GetComparisonStyle(currentName, comparisonName)">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                        <strong>@L["Name"]</strong><br/>
                        @if (isDifferent && CompareMode && ComparisonPerson != null)
                        {
                            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                                <div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["IncomingRequest"]</MudChip>
                                    <div data-testid="contact-name">@currentName</div>
                                </div>
                                <div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["ExistingPerson"]</MudChip>
                                    <div>@comparisonName</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(displayPerson.Contact.FirstName))
                            {
                                <span data-testid="contact-firstname">@displayPerson.Contact.FirstName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(displayPerson.Contact.LastName))
                            {
                                @if (!string.IsNullOrWhiteSpace(displayPerson.Contact.FirstName))
                                {
                                    @(" ")
                                }
                                <span data-testid="contact-lastname">@displayPerson.Contact.LastName</span>
                            }
                        }
                    </MudText>
                }

                @* Contact Info - Email and Phone *@
                @if (displayPerson.Contact != null)
                {
                    @if (!string.IsNullOrWhiteSpace(displayPerson.Contact.Email))
                    {
                        var currentEmail = displayPerson.Contact.Email;
                        var comparisonEmail = ComparisonPerson?.Contact?.Email;
                        var isDifferentEmail = IsDifferent(currentEmail, comparisonEmail);

                        <MudText Typo="Typo.body2" Class="mb-1" Style="@GetComparisonStyle(currentEmail, comparisonEmail)">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-1" />
                            <strong>@L["Email"]</strong><br/>
                            @if (isDifferentEmail && CompareMode && ComparisonPerson != null)
                            {
                                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                                    <div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["IncomingRequest"]</MudChip>
                                        <div data-testid="contact-email">@currentEmail</div>
                                    </div>
                                    <div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["ExistingPerson"]</MudChip>
                                        <div>@comparisonEmail</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span data-testid="contact-email">@displayPerson.Contact.Email</span>
                            }
                        </MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(displayPerson.Contact.PhoneNumber))
                    {
                        var currentPhone = displayPerson.Contact.PhoneNumber;
                        var comparisonPhone = ComparisonPerson?.Contact?.PhoneNumber;
                        var isDifferentPhone = IsDifferent(currentPhone, comparisonPhone);

                        <MudText Typo="Typo.body2" Class="mb-1" Style="@GetComparisonStyle(currentPhone, comparisonPhone)">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-1" />
                            <strong>@L["PhoneNumber"]</strong><br/>
                            @if (isDifferentPhone && CompareMode && ComparisonPerson != null)
                            {
                                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                                    <div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["IncomingRequest"]</MudChip>
                                        <div data-testid="contact-phone">@currentPhone</div>
                                    </div>
                                    <div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["ExistingPerson"]</MudChip>
                                        <div>@comparisonPhone</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span data-testid="contact-phone">@displayPerson.Contact.PhoneNumber</span>
                            }
                        </MudText>
                    }
                }

                @* Address *@
                @if (displayPerson.Address != null)
                {
                    var currentAddress = GetFullAddress(displayPerson.Address);
                    var comparisonAddress = GetFullAddress(ComparisonPerson?.Address);
                    var isDifferentAddress = IsDifferent(currentAddress, comparisonAddress);

                    <MudText Typo="Typo.body2" Style="@GetComparisonStyle(currentAddress, comparisonAddress)">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />
                        <strong>@L["Address"]</strong><br/>
                        @if (isDifferentAddress && CompareMode && ComparisonPerson != null)
                        {
                            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                                <div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["IncomingRequest"]</MudChip>
                                    <div>@currentAddress</div>
                                </div>
                                <div>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Style="height: 18px; font-size: 0.7rem; margin-bottom: 4px;">@L["ExistingPerson"]</MudChip>
                                    <div>@comparisonAddress</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(displayPerson.Address.Street))
                            {
                                <span data-testid="address-street">@displayPerson.Address.Street</span><span>, </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(displayPerson.Address.PostalCode))
                            {
                                <span data-testid="address-postalcode">@displayPerson.Address.PostalCode</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(displayPerson.Address.City))
                            {
                                @if (!string.IsNullOrWhiteSpace(displayPerson.Address.PostalCode))
                                {
                                    @(" ")
                                }
                                <span data-testid="address-city">@displayPerson.Address.City</span>
                            }
                        }
                    </MudText>
                }
            </div>

            @if (displayPerson.Id > 0)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                              Size="Size.Small"
                              Color="Color.Primary"
                              Variant="Variant.Outlined"
                              OnClick="@(() => NavigationManager.NavigateTo($"/admin/persons/{displayPerson.Id}"))"
                              Title="@L["ViewPerson"]" />
            }
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public PersonDto? Person { get; set; }

    [Parameter]
    public int? PersonId { get; set; }

    [Parameter]
    public bool CompareMode { get; set; } = false;

    [Parameter]
    public PersonDto? ComparisonPerson { get; set; }

    private PersonDto? displayPerson;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPerson();
    }

    private async Task LoadPerson()
    {
        // Use Person parameter if provided
        if (Person != null)
        {
            displayPerson = Person;
        }
        // Otherwise, if PersonId is provided, fetch the person
        else if (PersonId.HasValue)
        {
            var personService = DtoServiceFactory.Create<PersonDto, PersonSearch>();
            displayPerson = await personService.GetByIdAsync(PersonId.Value);
        }

        StateHasChanged();
    }

    private bool IsDifferent(string? currentValue, string? comparisonValue)
    {
        if (!CompareMode || ComparisonPerson == null || comparisonValue == null)
            return false;

        return !string.Equals(currentValue?.Trim(), comparisonValue?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private string GetComparisonStyle(string? currentValue, string? comparisonValue)
    {
        if (!CompareMode || ComparisonPerson == null || comparisonValue == null)
            return string.Empty;

        bool isDifferent = IsDifferent(currentValue, comparisonValue);

        if (isDifferent)
        {
            // Blue for differences
            return "background-color: rgba(33, 150, 243, 0.15); border-left: 3px solid #2196F3; padding-left: 8px; border-radius: 4px;";
        }
        else
        {
            // Green for matches
            return "background-color: rgba(76, 175, 80, 0.15); border-left: 3px solid #4CAF50; padding-left: 8px; border-radius: 4px;";
        }
    }

    private string GetFullName(ContactDto? contact)
    {
        if (contact == null) return string.Empty;
        var firstName = contact.FirstName?.Trim() ?? "";
        var lastName = contact.LastName?.Trim() ?? "";
        return $"{firstName} {lastName}".Trim();
    }

    private string GetFullAddress(AddressDto? address)
    {
        if (address == null) return string.Empty;
        var street = address.Street?.Trim() ?? "";
        var postalCode = address.PostalCode?.Trim() ?? "";
        var city = address.City?.Trim() ?? "";

        var parts = new List<string>();
        if (!string.IsNullOrEmpty(street)) parts.Add(street);
        if (!string.IsNullOrEmpty(postalCode) || !string.IsNullOrEmpty(city))
        {
            parts.Add($"{postalCode} {city}".Trim());
        }

        return string.Join(", ", parts);
    }
}
