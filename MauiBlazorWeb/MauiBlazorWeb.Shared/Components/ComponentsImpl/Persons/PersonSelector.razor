@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@inject GenericDtoServiceFactory DtoServiceFactory

<MudSelect T="int?"
           Label="@Label"
           Value="@SelectedPersonId"
           ValueChanged="@OnValueChanged"
           Variant="Variant.Outlined"
           Disabled="@IsReadOnly"
           Clearable="true"
           UserAttributes="@(new Dictionary<string, object> { { "data-testid", "person-selector" } })">
    @if (persons != null)
    {
        @foreach (var person in persons)
        {
            var displayText = $"{person.Contact?.FirstName} {person.Contact?.LastName}";
            if (!string.IsNullOrWhiteSpace(person.Contact?.Email))
            {
                displayText += $" ({person.Contact.Email})";
            }
            <MudSelectItem T="int?" Value="@person.Id">@displayText</MudSelectItem>
        }
    }
</MudSelect>

@code {
    [Parameter]
    public int? SelectedPersonId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedPersonIdChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Select Person";

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    private List<PersonDto>? persons;
    private GenericDtoService<PersonDto, PersonSearch>? _service;

    protected override async Task OnInitializedAsync()
    {
        _service = DtoServiceFactory.Create<PersonDto, PersonSearch>();

        // Load all persons - you might want to add pagination or search functionality
        var searchResult = await _service.GetAllAsync();
        persons = searchResult?.ToList();
    }

    private async Task OnValueChanged(int? value)
    {
        SelectedPersonId = value;
        await SelectedPersonIdChanged.InvokeAsync(value);
    }
}
