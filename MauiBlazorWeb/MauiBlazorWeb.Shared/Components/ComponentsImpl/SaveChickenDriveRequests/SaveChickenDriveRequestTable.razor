@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.StoredFiles
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using MudBlazor
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppResources> L

@code {
    [Parameter]
    public List<SaveChickenDriveRequestDto> items { get; set; } = new List<SaveChickenDriveRequestDto>();

    [Parameter] public EventCallback<SaveChickenDriveRequestDto> OnItemSelected { get; set; }
    void SelectItem(SaveChickenDriveRequestDto item) => OnItemSelected.InvokeAsync(item);

    [Parameter] public EventCallback<(string? SortBy, bool? SortDescending)> OnSortSelected { get; set; }
    void SortByColumn(string columnName, bool? descending) => OnSortSelected.InvokeAsync((columnName, descending));

    [Parameter] public EventCallback OnItemsChanged { get; set; }

    private string? currentColumnName = null;
    private bool? currentSortDescending = null;

    private void OnHeaderClick(string columnName)
    {
        bool? descending = currentColumnName == columnName ? !currentSortDescending : false;
        currentColumnName = columnName;
        currentSortDescending = descending;
        SortByColumn(columnName, descending);
    }

    private string? GetSortIcon(string columnName)
    {
        if (currentColumnName != columnName) return null;
        return currentSortDescending == true ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;
    }

    private void ShowItem(int id)
    {
        NavigationManager.NavigateTo($"/admin/save-chicken-drive-requests/{id}");
    }

    private void EditItem(SaveChickenDriveRequestDto saveChickenDriveRequestDto)
    {
        NavigationManager.NavigateTo($"/admin/save-chicken-drive-requests/{saveChickenDriveRequestDto.Id}/edit");

    }
}

<div style="overflow-x: auto; max-width: 100%;">
<MudDataGrid Items="@items" Hover="true" Dense="true" Striped="true" Bordered="true" SortMode="SortMode.None">
    <Columns>
        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.FirstName"))" Variant="Variant.Text" Style="text-transform: none;">
                    @L["Contact_FirstName"]
                        @if (GetSortIcon("Person.Contact.FirstName") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.FirstName")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.FirstName</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.LastName"))" Variant="Variant.Text" Style="text-transform: none;">
                    @L["Contact_LastName"]
                        @if (GetSortIcon("Person.Contact.LastName") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.LastName")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.LastName</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Person.Address.Street"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Address_Street"]
                        @if (GetSortIcon("Person.Address.Street") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Address.Street")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Address?.Street</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Address.City"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Address_City"]
                        @if (GetSortIcon("Person.Address.City") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Address.City")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Address?.City</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Address.PostalCode"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Address_PostalCode"]
                        @if (GetSortIcon("Person.Address.PostalCode") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Address.PostalCode")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Address?.PostalCode</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.PhoneNumber"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Contact_Phone"]
                        @if (GetSortIcon("Person.Contact.PhoneNumber") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.PhoneNumber")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.PhoneNumber</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.Email"))" Variant="Variant.Text" Style="text-transform: none;">
                    @L["Contact_Email"]
                        @if (GetSortIcon("Person.Contact.Email") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.Email")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.Email</CellTemplate>
        </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("CarMake"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["CarMake"]
                        @if (GetSortIcon("CarMake") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("CarMake")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>@context.Item.CarMake</CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("CapacityForChickens"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["CapacityForChickens"]
                        @if (GetSortIcon("CapacityForChickens") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("CapacityForChickens")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>@context.Item.CapacityForChickens</CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("AvailableDates"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["AvailableDates"]
                        @if (GetSortIcon("AvailableDates") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("AvailableDates")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>
                    @string.Join(", ", context.Item.AvailableDates.Select(d => d.ToString("dd.MM.yyyy")))
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("SaveChickenActionId"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["SaveChickenAction"]
                        @if (GetSortIcon("SaveChickenActionId") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("SaveChickenActionId")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>
                    @{
                        var action = context.Item.SaveChickenAction;
                        var actionId = context.Item.SaveChickenActionId;
                    }
                    @(action?.Title ?? actionId?.ToString() ?? string.Empty)
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    @L["Files"]
                </HeaderTemplate>
                <CellTemplate>
                    @foreach (var file in context.Item.Files)
                    {
                        <StoredFileDialog StoredFile="file" />
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["show"]</HeaderTemplate>
                <CellTemplate>
                    <MudButton Variant="Variant.Filled"
                               OnClick="@(() => ShowItem(context.Item.Id))"
                               UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "view-button" })">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["edit"]</HeaderTemplate>
                <CellTemplate>
                    @if (context.Item != null)
                    {
                        var itemWithFiles = new ItemWithBrowserFiles<SaveChickenDriveRequestDto> { Item = context.Item };
                        <GenericUpdateWithFilesDialogLauncher TDto="SaveChickenDriveRequestDto"
                                                        model="itemWithFiles"
                                                        OnEdited="@(() => OnItemsChanged.InvokeAsync())">
                            <ChildContent Context="editModel">
                                <SaveChickenDriveRequestFormWithFiles EntityWithFiles="editModel" />
                            </ChildContent>
                        </GenericUpdateWithFilesDialogLauncher>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["delete"]</HeaderTemplate>
                <CellTemplate>
                    <GenericDeleteDialog TDto="SaveChickenDriveRequestDto"
                                         Model="context.Item"
                                         OnDeleted="@(() => OnItemsChanged.InvokeAsync())" />
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["copy"]</HeaderTemplate>
                <CellTemplate>
                    @if (context.Item != null)
                    {
                        <SaveChickenActionSelectorDialogLauncher TDto="SaveChickenDriveRequestDto"
                                                                 Model="context.Item"
                                                                 OnCopied="@(() => OnItemsChanged.InvokeAsync())"
                                                                 ExcludeIds="@(context.Item.SaveChickenActionId.HasValue ? new List<int> { context.Item.SaveChickenActionId.Value } : null)" />
                    }
                </CellTemplate>
            </TemplateColumn>

    </Columns>
</MudDataGrid>
</div>
