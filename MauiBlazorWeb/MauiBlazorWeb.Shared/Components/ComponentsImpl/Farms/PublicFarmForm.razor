@using MauiBlazorWeb.Shared.Components.MultiDateSelecters
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@inject IStringLocalizer<AppResources> L
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject SaveChickenActionService SaveChickenActionService

@code {
    [Parameter, EditorRequired]
    public FarmPublicDto Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnSubmitSuccess { get; set; }

    private bool isSubmitting = false;
    private SaveChickenActionDto? _saveChickenActionDto;

    private DateOnly? minDate =>
        _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
            ? _saveChickenActionDto.Dates.Min()
            : null;

    private DateOnly? maxDate =>
        _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
            ? _saveChickenActionDto.Dates.Max()
            : null;

    protected override async Task OnInitializedAsync()
    {
        await GetActiveSaveChickenAction();
    }

    private async Task GetActiveSaveChickenAction()
    {
        try
        {
            _saveChickenActionDto = await SaveChickenActionService.GetActiveSaveChickenAction();
            if (_saveChickenActionDto != null)
            {
                Model.SaveChickenActionId = _saveChickenActionDto.Id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading active action: {ex.Message}");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("api/Farm/public", Model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Vielen Dank! Ihre Betriebsmeldung wurde erfolgreich gesendet.", Severity.Success);
                await OnSubmitSuccess.InvokeAsync();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Fehler beim Senden der Meldung: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ein Fehler ist aufgetreten: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <!-- Contact Information -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Kontaktinformationen</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.FirstName" Label="Vorname*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-firstname" })" />
                <ValidationMessage For="@(() => Model.FirstName)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.LastName" Label="Nachname*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-lastname" })" />
                <ValidationMessage For="@(() => Model.LastName)" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.Email" Label="E-Mail*" Variant="Variant.Outlined" InputType="InputType.Email"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-email" })" />
                <ValidationMessage For="@(() => Model.Email)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.PhoneNumber" Label="Telefonnummer*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-phone" })" />
                <ValidationMessage For="@(() => Model.PhoneNumber)" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Address Information -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Adresse des Betriebs</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.City" Label="Ort*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-city" })" />
                <ValidationMessage For="@(() => Model.City)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.PostalCode" Label="PLZ*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-postalcode" })" />
                <ValidationMessage For="@(() => Model.PostalCode)" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Street" Label="Strasse und Hausnummer*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-street" })" />
                <ValidationMessage For="@(() => Model.Street)" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Farm Information -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Informationen zum Betrieb</MudText>

        <MudItem Class="mb-3">
            <MudTextField @bind-Value="Model.Name" Label="Name des Betriebs*" Variant="Variant.Outlined"
                         UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "farm-name" })" />
            <ValidationMessage For="@(() => Model.Name)" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudNumericField T="int" @bind-Value="Model.NumberOfChickens" Label="Anzahl Hühner*"
                            Variant="Variant.Outlined" Min="0"
                            UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "chickens-count" })" />
            <ValidationMessage For="@(() => Model.NumberOfChickens)" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudNumericField T="int" @bind-Value="Model.NumberOfRoosters" Label="Anzahl Hähne"
                            Variant="Variant.Outlined" Min="0"
                            UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "roosters-count" })" />
            <ValidationMessage For="@(() => Model.NumberOfRoosters)" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudTextField @bind-Value="Model.Size" Label="Betriebsgröße" Variant="Variant.Outlined" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudTextField @bind-Value="Model.Color" Label="Farbe der Hühner" Variant="Variant.Outlined" />
        </MudItem>

        <MudDivider Class="my-4" />

        <MudItem Class="mb-3">
            <MudText Class="mb-2">Allgemeine Informationen zum Betrieb:</MudText>
            <MudTextField @bind-Value="Model.GeneralInformation" Label="Zusätzliche Informationen"
                         Variant="Variant.Outlined" Lines="4"
                         UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "general-info" })" />
        </MudItem>
    </MudPaper>


    <!-- Action Selector (hidden, auto-selected) -->
    @if (_saveChickenActionDto != null)
    {
        <input type="hidden" @bind="Model.SaveChickenActionId" />
    }

    <!-- Submit Button -->
    <MudButton ButtonType="ButtonType.Submit"
              Variant="Variant.Filled"
              Color="Color.Primary"
              Size="Size.Large"
              Disabled="isSubmitting"
              FullWidth="true"
              data-testid="submit-button">
        @if (isSubmitting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <span class="ml-2">Wird gesendet...</span>
        }
        else
        {
            <span>Betrieb anmelden</span>
        }
    </MudButton>
</EditForm>
