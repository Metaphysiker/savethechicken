@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Contacts
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Addresses
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.FileUploads
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using Microsoft.Extensions.Localization
@inject GenericDtoServiceFactory DtoServiceFactory
@using MudBlazor
@inject IStringLocalizer<AppResources> L

@using global::Shared.Dtos.DtosImpl
@code {
    [Parameter, EditorRequired]
    public ItemWithBrowserFiles<FarmDto> EntityWithFiles { get; set; } = default!;

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    [Parameter]
    public int? PreSelectedSaveChickenActionId { get; set; }

    private bool isSaveChickenActionSelectorReadOnly => IsReadOnly || EntityWithFiles.Item.Id > 0 || PreSelectedSaveChickenActionId.HasValue;
}

<SaveChickenActionSelector SelectedActionId="EntityWithFiles.Item.SaveChickenActionId"
                           SelectedActionIdChanged="OnSaveChickenActionIdChanged"
                           IsReadOnly="@isSaveChickenActionSelectorReadOnly" />

@if (PreSelectedSaveChickenActionId.HasValue)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
        @L["ActionPreselected_Info"]
    </MudAlert>
}

<ContactForm Contact="EntityWithFiles.Item.Contact" IsReadOnly="@IsReadOnly" />
<AddressForm Address="EntityWithFiles.Item.Address" IsReadOnly="@IsReadOnly" />

<MudPaper Class="pa-4 my-4" Elevation="2">
    <MudText Typo="Typo.h6">Allgemeine Informationen</MudText>

    <MudTextField ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.Name" Label="@L["Farm_Name"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "farm-name" })" />
    <ValidationMessage For="@(() => EntityWithFiles.Item.Name)" />

    <MudNumericField ReadOnly="@IsReadOnly" T="int" @bind-Value="EntityWithFiles.Item.NumberOfChickens" Label="@L["NumberOfChickens"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "number-of-chickens" })" />
    <ValidationMessage For="@(() => EntityWithFiles.Item.NumberOfChickens)" />

    <MudNumericField ReadOnly="@IsReadOnly" T="int" @bind-Value="EntityWithFiles.Item.NumberOfRoosters" Label="@L["NumberOfRoosters"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "number-of-roosters" })" />
    <ValidationMessage For="@(() => EntityWithFiles.Item.NumberOfRoosters)" />

    <MudTextField ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.Size" Label="@L["Farm_Size"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "farm-size" })" />
    <ValidationMessage For="@(() => EntityWithFiles.Item.Size)" />

   <MudTextField ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.Color" Label="@L["Color"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "farm-color" })" />
    <ValidationMessage For="@(() => EntityWithFiles.Item.Color)" />

    <MudDivider Class="my-2"></MudDivider>

    <MudText>Weitere Informationen:</MudText>

    <MudTextField ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.GeneralInformation" Label="@L["GeneralInformation"]" Variant="Variant.Outlined" Lines="3" UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "farm-general-info" })" />
    <ValidationMessage For="@(() => EntityWithFiles.Item.GeneralInformation)" />
</MudPaper>




<FilesUploadForm @bind-Value="EntityWithFiles.Files" Label="Dateien hochladen" Text="Routenpläne" />

@code {
    private GenericDtoService<SaveChickenActionDto, SaveChickenActionSearch>? _saveChickenActionService;
    private SaveChickenActionDto? _saveChickenActionDto;
    private DateOnly? minDate =>
    _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
        ? _saveChickenActionDto.Dates.Min()
        : null;

    private DateOnly? maxDate =>
    _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
        ? _saveChickenActionDto.Dates.Max()
        : null;

    protected override async Task OnInitializedAsync()
    {
        _saveChickenActionService = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();

        // Set PreSelectedSaveChickenActionId if provided
        if (PreSelectedSaveChickenActionId.HasValue && EntityWithFiles.Item.SaveChickenActionId == null)
        {
            EntityWithFiles.Item.SaveChickenActionId = PreSelectedSaveChickenActionId.Value;
        }

        await getSaveChickenAction();
    }

    private async Task getSaveChickenAction()
    {
        if(_saveChickenActionService == null)
        {
            return;
        }

        if (EntityWithFiles.Item.SaveChickenActionId.HasValue)
        {
            _saveChickenActionDto = await _saveChickenActionService.GetByIdAsync(EntityWithFiles.Item.SaveChickenActionId.Value);
        }
    }

    private async Task OnSaveChickenActionIdChanged(int? newId)
    {
        EntityWithFiles.Item.SaveChickenActionId = newId;
        await getSaveChickenAction();
        StateHasChanged();
    }
}
