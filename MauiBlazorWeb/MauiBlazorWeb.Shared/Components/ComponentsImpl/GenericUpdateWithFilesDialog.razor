@using MudBlazor
@typeparam TDto where TDto : class, IEntityWithFileDtos

<MudDialog>
    <DialogContent>
        @if(Model != null && ChildContent != null)
        {
            <GenericUpdateWithFiles TDto="TDto" 
                                   model="@Model" 
                                   ChildContent="@ChildContent"
                                   OnEdited="@HandleEdited" />
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public ItemWithBrowserFiles<TDto> Model { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<ItemWithBrowserFiles<TDto>> ChildContent { get; set; } = default!;
    [Parameter] public EventCallback OnEdited { get; set; }
    
    private async Task HandleEdited()
    {
        await OnEdited.InvokeAsync();
        MudDialog?.Close(DialogResult.Ok(true));
    }
}