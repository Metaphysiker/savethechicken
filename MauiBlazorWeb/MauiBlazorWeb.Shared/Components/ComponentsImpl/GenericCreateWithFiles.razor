@*
Requires interactive rendering mode for OnValidSubmit to work.
App uses global @rendermode="InteractiveServer" in App.razor.
*@
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using MudBlazor
@inject AwsFileService AwsFileService
@inject AuthService AuthService
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@inject IJSRuntime JS
@typeparam TDto where TDto : class, IEntityWithFileDtos
@inject GenericDtoServiceFactory DtoServiceFactory
@inject IStringLocalizer<AppResources> L
@inject NavigationManager NavigationManager

@if(model != null){
    <div class="form-wrapper-div">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
        <ObjectGraphDataAnnotationsValidator />

        @ChildContent(model)

        <MudButton data-testid="submit-button" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Creating"]...</MudText>
            }
            else
            {
                @L["Create"]
            }
        </MudButton>
    </EditForm>
    </div>
}

@code {
    [Parameter, EditorRequired] public ItemWithBrowserFiles<TDto> model { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment<ItemWithBrowserFiles<TDto>> ChildContent { get; set; } = default!;

    [Parameter] public string? ResourceName { get; set; }
    
    [Parameter] public EventCallback OnCreated { get; set; }

    private GenericDtoService<TDto, ISearchDto>? _service;
    private string? errorMessage;
    private bool isSubmitting = false;



    protected override void OnInitialized()
    {
        _service = DtoServiceFactory.Create<TDto, ISearchDto>();
        if (model == null)
        {
            model = Activator.CreateInstance<ItemWithBrowserFiles<TDto>>();
        }
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (_service != null && model != null)
        {
            errorMessage = null;
            isSubmitting = true;
            StateHasChanged();

            try
            {
                var storedFiles = await UploadFilesAsync(model);
                model.Item.Files.AddRange(storedFiles);

                // Check if user is logged in
                bool isLoggedIn = await AuthService.CheckIfLoggedInAsync();

                TDto createdItem;
                if (isLoggedIn)
                {
                    createdItem = await _service.CreateAsync(model.Item);
                }
                else
                {
                    // Use public endpoint for non-authenticated users
                    createdItem = await _service.CreatePublicAsync(model.Item);
                }

                // Navigate based on user role and configuration
                if (OnCreated.HasDelegate)
                {
                    // Dialog mode: invoke callback instead of navigation
                    await OnCreated.InvokeAsync();
                }
                else if (isLoggedIn && !string.IsNullOrEmpty(ResourceName))
                {
                    // Admin: navigate to detail page
                    var idProperty = createdItem.GetType().GetProperty("Id");
                    if (idProperty != null)
                    {
                        var id = idProperty.GetValue(createdItem);
                        NavigationManager.NavigateTo($"/{ResourceName}/{id}");
                    }
                    else
                    {
                        // Fallback if Id property not found
                        NavigationManager.NavigateTo("/thank-you");
                    }
                }
                else
                {
                    // Public user: navigate to thank-you page
                    NavigationManager.NavigateTo("/thank-you");
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to create: {ex.Message}";
                isSubmitting = false;
                StateHasChanged();
            }
        }
    }

    private async Task<List<StoredFileDto>> UploadFilesAsync(ItemWithBrowserFiles<TDto> itemWithFiles)
    {
        List<StoredFileDto> storedFiles = new List<StoredFileDto>();
        foreach (var file in itemWithFiles.Files)
        {
            var key = await AwsFileService.UploadFileAsync(file);
            if(!string.IsNullOrEmpty(key))
            {
                StoredFileDto storedFile = new StoredFileDto
                {
                    FileName = file.Name,
                    FileKey = key,
                    ContentType = file.ContentType,
                };

                storedFiles.Add(storedFile);
            }
        }
        return storedFiles;
    }
}
