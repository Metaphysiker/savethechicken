@using MudBlazor
@inject StoredFileHelper storedFileHelper
@*
Requires interactive rendering mode for OnValidSubmit to work.
App uses global @rendermode="InteractiveServer" in App.razor.
*@
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Helpers
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@inject AwsFileService AwsFileService
@using Microsoft.Extensions.Logging
@inject Microsoft.Extensions.Logging.ILogger<GenericUpdateWithFiles<TDto>> Logger
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos
@using global::Shared.Dtos.DtosImpl
@inject IJSRuntime JS
@typeparam TDto where TDto : class, IDto, IEntityWithFileDtos
@inject GenericDtoServiceFactory DtoServiceFactory
@inject IStringLocalizer<AppResources> L

@if(model != null){
    <div class="form-wrapper-div">
        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <ObjectGraphDataAnnotationsValidator />

            @ChildContent(model)

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                @(IsCreate ? L["Create"] : L["Update"])
            </MudButton>

        </EditForm>
    </div>
}

@code {
    [Parameter, EditorRequired] public ItemWithBrowserFiles<TDto> model { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<ItemWithBrowserFiles<TDto>> ChildContent { get; set; } = default!;
    [Parameter]
    public EventCallback OnEdited { get; set; }
    private GenericDtoService<TDto, ISearchDto>? _service;
    private bool IsCreate => model?.Item?.Id == 0;

    protected override void OnInitialized()
    {
        _service = DtoServiceFactory.Create<TDto, ISearchDto>();
    }

    private async Task HandleValidSubmit()
    {
        if (_service != null && model != null)
        {
            try
            {
                TDto updatedItem;
                if (IsCreate)
                {
                    updatedItem = await _service.CreateAsync(model.Item);
                }
                else
                {
                    updatedItem = await _service.UpdateAsync(model.Item);
                }

                if (updatedItem != null)
                {
                    List<StoredFileDto>? storedFiles = await storedFileHelper.UploadFilesAsync(model.Files, updatedItem, AwsFileService, DtoServiceFactory.Create<StoredFileDto, ISearchDto>());
                }

                await OnEdited.InvokeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Exception in HandleValidSubmit");
                throw;
            }
        }
        else
        {
            Logger.LogWarning("_service or model is null in HandleValidSubmit");
        }
    }
}
