@using Microsoft.Extensions.Localization
@using MauiBlazorWeb.Shared.Resources.Strings
@inject IStringLocalizer<AppResources> L
@inject IJSRuntime JS

<MudPaper Class="pa-4 my-4">

<MudText>
    @Text
</MudText>

<MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="FileChanged">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.CloudUpload">
            @Label
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

        @if (!string.IsNullOrEmpty(_fileSizeWarning))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_fileSizeWarning</MudAlert>
        }
        @if (Value != null)
        {
            <MudList T="string">
                @foreach (var file in Value.ToList())
                {
                    <MudListItem Icon="@Icons.Material.Filled.AttachFile">
                        @file.Name <code>@($"{file.Size / (1024.0 * 1024.0):0.##} MB")</code>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Style="margin-left:8px;"
                                       OnClick="@(() => RemoveFile(file))" />
                    </MudListItem>
                }
            </MudList>
        }


</MudPaper>
@code {
    [Parameter] public List<IBrowserFile> Value { get; set; } = new();
    [Parameter] public EventCallback<List<IBrowserFile>> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Dateien hochladen";
    [Parameter] public string Text { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Value ??= new List<IBrowserFile>();
    }

    private string _fileSizeWarning = string.Empty;

    private async Task FileChanged(IReadOnlyList<IBrowserFile> files)
    {
        _fileSizeWarning = string.Empty;

        foreach (var file in files)
        {
            IBrowserFile fileToProcess = file;

            // Check if the file is an image
            if (file.ContentType.StartsWith("image/"))
            {
                try
                {
                    // Resize to max 1920px width/height while maintaining aspect ratio
                    // This significantly reduces file size and memory footprint
                    fileToProcess = await file.RequestImageFileAsync(file.ContentType, 1920, 1920);
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("console.error", $"Compression failed: {ex.Message}");
                }
            }

            // Check size after potential compression (10MB limit example)
            if (fileToProcess.Size > 10 * 1024 * 1024)
            {
                _fileSizeWarning = string.Format(L["FileTooLargeWarning"], fileToProcess.Name);
                continue;
            }

            if (!Value.Any(f => f.Name == fileToProcess.Name && f.Size == fileToProcess.Size))
            {
                Value.Add(fileToProcess);
            }
        }

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }

        StateHasChanged();
    }

    private async Task RemoveFile(IBrowserFile file)
    {
        Value.Remove(file);
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
        await JS.InvokeVoidAsync("console.log", $"Removed file: {file.Name}");
    }
}
