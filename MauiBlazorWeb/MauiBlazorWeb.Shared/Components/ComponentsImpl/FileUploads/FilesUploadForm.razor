@using Microsoft.Extensions.Localization
@using MauiBlazorWeb.Shared.Resources.Strings
@inject IStringLocalizer<AppResources> L
@inject IJSRuntime JS

<MudPaper Class="pa-4 my-4">

<MudText>
    @Text
</MudText>

<MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="FileChanged">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.CloudUpload">
            @Label
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

        @if (!string.IsNullOrEmpty(_fileSizeWarning))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_fileSizeWarning</MudAlert>
        }
        @if (Value != null)
        {
            <MudList T="string">
                @foreach (var file in Value.ToList())
                {
                    <MudListItem Icon="@Icons.Material.Filled.AttachFile">
                        @file.Name <code>@($"{file.Size / (1024.0 * 1024.0):0.##} MB")</code>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Style="margin-left:8px;"
                                       OnClick="@(() => RemoveFile(file))" />
                    </MudListItem>
                }
            </MudList>
        }


</MudPaper>
@code {
    [Parameter] public List<IBrowserFile> Value { get; set; } = new();
    [Parameter] public EventCallback<List<IBrowserFile>> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Dateien hochladen";
    [Parameter] public string Text { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Value ??= new List<IBrowserFile>();
    }

    private string _fileSizeWarning = string.Empty;

    private async void FileChanged(IReadOnlyList<IBrowserFile> files)
    {
        _fileSizeWarning = string.Empty;
        await JS.InvokeVoidAsync("console.log", "Files changed:");

        foreach (var file in files)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                _fileSizeWarning = string.Format(L["FileTooLargeWarning"], file.Name);
                continue;
            }
            if (!Value.Contains(file))
            {
                Value.Add(file);
            }
        }
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }

        await JS.InvokeVoidAsync("console.log", Value);
        StateHasChanged();
    }

    private async Task RemoveFile(IBrowserFile file)
    {
        Value.Remove(file);
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
        await JS.InvokeVoidAsync("console.log", $"Removed file: {file.Name}");
    }
}
