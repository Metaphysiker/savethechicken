@using Microsoft.Extensions.Localization
@using MauiBlazorWeb.Shared.Resources.Strings
@inject IStringLocalizer<AppResources> L
@inject IJSRuntime JS

<MudPaper Class="pa-4 my-4">

<MudText>
    @Text
</MudText>

<MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="FileChanged"
               Accept="image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.oasis.opendocument.text,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.oasis.opendocument.spreadsheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.presentation">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.CloudUpload">
            @Label
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

        @if (!string.IsNullOrEmpty(_fileSizeWarning))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_fileSizeWarning</MudAlert>
        }
        @if (Value != null)
        {
            <MudList T="string">
                @foreach (var file in Value.ToList())
                {
                    <MudListItem Icon="@Icons.Material.Filled.AttachFile">
                        @file.Name <code>@($"{file.Size / (1024.0 * 1024.0):0.##} MB")</code>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Style="margin-left:8px;"
                                       OnClick="@(() => RemoveFile(file))" />
                    </MudListItem>
                }
            </MudList>
        }


</MudPaper>
@code {
    [Parameter] public List<IBrowserFile> Value { get; set; } = new();
    [Parameter] public EventCallback<List<IBrowserFile>> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Dateien hochladen";
    [Parameter] public string Text { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Value ??= new List<IBrowserFile>();
    }

    private string _fileSizeWarning = string.Empty;

    private async Task FileChanged(IReadOnlyList<IBrowserFile> files)
    {
        _fileSizeWarning = string.Empty;

        foreach (var file in files)
        {
            IBrowserFile fileToProcess = file;

            // Check if the file is an image that the browser can process (HEIC/HEIF not supported by canvas API)
            if (file.ContentType.StartsWith("image/") && !IsHeicFile(file))
            {
                try
                {
                    // 5s timeout: canvas hangs indefinitely on images the browser can't decode
                    var resizeTask = file.RequestImageFileAsync(file.ContentType, 1920, 1920).AsTask();
                    if (await Task.WhenAny(resizeTask, Task.Delay(5000)) == resizeTask)
                    {
                        fileToProcess = await resizeTask;
                        if (fileToProcess.Size == 0)
                            fileToProcess = file;
                    }
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("console.error", $"Compression failed: {ex.Message}");
                }
            }

            // Check size after potential compression (10MB limit example)
            if (fileToProcess.Size > 10 * 1024 * 1024)
            {
                _fileSizeWarning = string.Format(L["FileTooLargeWarning"], fileToProcess.Name);
                continue;
            }

            if (!Value.Any(f => f.Name == fileToProcess.Name && f.Size == fileToProcess.Size))
            {
                Value.Add(fileToProcess);
            }
        }

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }

        StateHasChanged();
    }

    private static bool IsHeicFile(IBrowserFile file) =>
        file.ContentType is "image/heic" or "image/heif"
        || file.Name.EndsWith(".heic", StringComparison.OrdinalIgnoreCase)
        || file.Name.EndsWith(".heif", StringComparison.OrdinalIgnoreCase);

    private async Task RemoveFile(IBrowserFile file)
    {
        Value.Remove(file);
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
        await JS.InvokeVoidAsync("console.log", $"Removed file: {file.Name}");
    }
}
