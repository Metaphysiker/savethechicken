@using Microsoft.Extensions.Localization
@using MauiBlazorWeb.Shared.Resources.Strings
@using MudBlazor
@inject IStringLocalizer<AppResources> L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">@Title</MudText>
        <MudPaper Class="pa-3" Elevation="0" Style="white-space: pre-wrap; word-wrap: break-word;">
            <MudText Typo="Typo.body1">@Content</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Text">
            @L["Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string? Content { get; set; }

    [Parameter]
    public string? Title { get; set; }

    private void Close()
    {
        MudDialog?.Close();
    }
}
