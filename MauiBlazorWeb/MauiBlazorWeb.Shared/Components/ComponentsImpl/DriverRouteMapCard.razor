@using MauiBlazorWeb.Shared.Classes
@using global::Shared.Dtos.DtosImpl

<MudPaper Class="my-3 pa-3" Elevation="3">
    <MudGrid Spacing="2">
        @* Map *@
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.subtitle2" Class="mb-2">
                <strong>@Driver.Person?.Contact?.FirstName @Driver.Person?.Contact?.LastName</strong>
            </MudText>
            @if (Markers.Any())
            {
                <OpenStreetMap Markers="Markers" Arrows="Arrows" />
            }
            else
            {
                <MudPaper Class="pa-4" Elevation="0" Style="background-color: #f5f5f5; text-align: center;">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Keine Anfragen mit Standort zugeordnet</MudText>
                </MudPaper>
            }
        </MudItem>

        @* Info panel *@
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Details</MudText>

            <MudPaper Class="pa-2 mb-2" Elevation="0" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.body2">
                    <strong>Kapazität:</strong> @TotalSelectedAnimals / @Driver.CapacityForChickens
                    @if (TotalSelectedAnimals > Driver.CapacityForChickens)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Überladen!</MudChip>
                    }
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Info">
                    <strong>Strecke (Luftlinie):</strong> @TotalDistanceKm.ToString("F1") km
                </MudText>
                <MudText Typo="Typo.body2">
                    <strong>Stopps:</strong> @Markers.Count
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public SaveChickenDriveRequestDto Driver { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<MapMarker> Markers { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<MapArrow> Arrows { get; set; } = default!;

    [Parameter]
    public double TotalDistanceKm { get; set; }

    [Parameter]
    public int TotalSelectedAnimals { get; set; }
}
