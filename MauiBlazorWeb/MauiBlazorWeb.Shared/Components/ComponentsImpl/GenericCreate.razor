@*
Requires interactive rendering mode for OnValidSubmit to work.
App uses global @rendermode="InteractiveServer" in App.razor.
*@
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@typeparam TDto where TDto : class
@inject GenericDtoServiceFactory DtoServiceFactory
@inject IStringLocalizer<AppResources> L
@inject NavigationManager NavigationManager

@if(model != null){
    <div class="form-wrapper-div">
        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <ObjectGraphDataAnnotationsValidator />

            @ChildContent(model)

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       data-testid="submit-button">
                @L["Create"]
            </MudButton>
        </EditForm>
    </div>
}

@code {
    [Parameter] public TDto model { get; set; } = default!;
    [Parameter] public RenderFragment<TDto> ChildContent { get; set; } = default!;
    [Parameter] public string? ResourceName { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }

    private GenericDtoService<TDto, ISearchDto>? _service;



    protected override void OnInitialized()
    {
        _service = DtoServiceFactory.Create<TDto, ISearchDto>();
        if (model == null)
        {
            model = Activator.CreateInstance<TDto>();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (_service != null)
        {
            try
            {
                var createdDto = await _service.CreateAsync(model);

                // Call OnSuccess callback if provided
                if (OnSuccess.HasDelegate)
                {
                    await OnSuccess.InvokeAsync();
                    return;
                }

                // Navigate to detail page if ResourceName is provided and dto has Id property
                if (!string.IsNullOrEmpty(ResourceName) && createdDto != null)
                {
                    var idProperty = createdDto.GetType().GetProperty("Id");
                    if (idProperty != null)
                    {
                        var id = idProperty.GetValue(createdDto);
                        NavigationManager.NavigateTo($"/{ResourceName}/{id}");
                        return;
                    }
                }

                // Fallback to thank-you page
                NavigationManager.NavigateTo("/thank-you");
            }
            catch (Exception)
            {
                // Optionally show an error message to the user
                // e.g., set an error flag or log the exception
            }
        }
    }
}
