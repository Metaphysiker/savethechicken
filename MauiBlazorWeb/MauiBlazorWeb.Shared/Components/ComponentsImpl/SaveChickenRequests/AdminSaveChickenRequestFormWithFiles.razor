@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Contacts
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Addresses
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.FileUploads
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.StoredFiles
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Persons
@using MauiBlazorWeb.Shared.Components.MultiDateSelecters
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using Microsoft.Extensions.Localization
@using MudBlazor
@using global::Shared.Dtos.DtosImpl
@inject IStringLocalizer<AppResources> L
@inject GenericDtoServiceFactory DtoServiceFactory

@code {
    [Parameter, EditorRequired]
    public ItemWithBrowserFiles<SaveChickenRequestDto> EntityWithFiles { get; set; } = default!;

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    protected override void OnInitialized()
    {
        // Initialize Person if null
        if (EntityWithFiles.Item.Person == null)
        {
            EntityWithFiles.Item.Person = new PersonDto
            {
                Contact = new ContactDto(),
                Address = new AddressDto()
            };
        }

        // Ensure Contact and Address are always initialized
        if (EntityWithFiles.Item.Person.Contact == null)
        {
            EntityWithFiles.Item.Person.Contact = new ContactDto();
        }

        if (EntityWithFiles.Item.Person.Address == null)
        {
            EntityWithFiles.Item.Person.Address = new AddressDto();
        }
    }

    private async Task OnPersonIdChanged(int? newPersonId)
    {
        EntityWithFiles.Item.PersonId = newPersonId;

        if (newPersonId.HasValue && newPersonId.Value > 0)
        {
            // Load the selected person
            var personService = DtoServiceFactory.Create<PersonDto, PersonSearch>();
            var person = await personService.GetByIdAsync(newPersonId.Value);

            if (person != null)
            {
                EntityWithFiles.Item.Person = person;
            }
        }
        else
        {
            // Create new person
            EntityWithFiles.Item.Person = new PersonDto
            {
                Contact = new ContactDto(),
                Address = new AddressDto()
            };
        }

        StateHasChanged();
    }
}

<MudPaper Class="pa-4 my-4">
    <MudText Typo="Typo.h6">Person Information</MudText>
    <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
        <strong>Admin Feature:</strong> You can select an existing person or create a new one by leaving the dropdown empty.
    </MudAlert>

    <PersonSelector SelectedPersonId="@EntityWithFiles.Item.PersonId"
                    SelectedPersonIdChanged="OnPersonIdChanged"
                    Label="Select Existing Person (Optional)"
                    IsReadOnly="@IsReadOnly" />
</MudPaper>

<ContactForm Contact="EntityWithFiles.Item.Person!.Contact" IsReadOnly="@IsReadOnly" />
<AddressForm Address="EntityWithFiles.Item.Person!.Address" IsReadOnly="@IsReadOnly" />

<MudPaper Class="pa-4 my-4" data-testid="save-chicken-request-general-info">
    <MudText Typo="Typo.h6">Allgemeine Informationen</MudText>
    <MudItem>
        <MudNumericField ReadOnly="@IsReadOnly" T="int" @bind-Value="EntityWithFiles.Item.NumberOfChickensToBeSaved" Label="@L["NumberOfChickens"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { { "data-testid", "chickens-count" } })" />
        <ValidationMessage For="@(() => EntityWithFiles.Item.NumberOfChickensToBeSaved)" />
    </MudItem>
        <MudItem>
        <MudNumericField ReadOnly="@IsReadOnly" T="int" @bind-Value="EntityWithFiles.Item.NumberOfRoostersToBeSaved" Label="@L["NumberOfRoostersToBeSaved"]" Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object> { { "data-testid", "roosters-count" } })" />
        <ValidationMessage For="@(() => EntityWithFiles.Item.NumberOfRoostersToBeSaved)" />
    </MudItem>

    <MudDivider Class="my-2"></MudDivider>

    <MudItem Class="my-2">
        <MudText>
            Bitte beschreiben Sie kurz  Ihr Hühnerzuhause (Stall, Auslauf m2) , Anzahl bestehende Hühner, Erfahrung etc.
        </MudText>
        <MudTextField ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.DescriptionOfPlaceForChickens" Label="@L["Description"]" Variant="Variant.Outlined" Lines="3" UserAttributes="@(new Dictionary<string, object> { { "data-testid", "description" } })" />
        <ValidationMessage For="@(() => EntityWithFiles.Item.DescriptionOfPlaceForChickens)" />
    </MudItem>

    <MudItem>
        <MudCheckBox ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.AlreadyReceivedChickenPreviously" Label="@L["AlreadyReceivedChickenPreviously"]"></MudCheckBox>
        <ValidationMessage For="@(() => EntityWithFiles.Item.AlreadyReceivedChickenPreviously)" />
    </MudItem>

</MudPaper>

<MultiDateOnlySelector @bind-SelectedDates="EntityWithFiles.Item.DatesForHandOver" Text="Ich bin an diesen Tagen erreichbar:" MinDate="@minDate" MaxDate="@maxDate" />

<StoredFilesEdit @bind-Files="EntityWithFiles.Item.Files" />

<FilesUploadForm @bind-Value="EntityWithFiles.Files" Label="Dateien hochladen" Text="" />

<SaveChickenActionSelector SelectedActionId="EntityWithFiles.Item.SaveChickenActionId"
                          SelectedActionIdChanged="OnSaveChickenActionIdChanged" />


<MudPaper Class="pa-4 my-4">
    <MudCheckBox ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.ConfirmThatIFulfillCriteria" Label="@L["ConfirmThatIFulfillCriteria"]"></MudCheckBox>
    <ValidationMessage For="@(() => EntityWithFiles.Item.ConfirmThatIFulfillCriteria)" />

    <MudCheckBox ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.AcceptTermsAndConditions" Label="@L["AcceptTermsAndConditions"]"></MudCheckBox>
    <ValidationMessage For="@(() => EntityWithFiles.Item.AcceptTermsAndConditions)" />

     <MudDivider Class="my-2"></MudDivider>

    <MudItem Class="my-2">
        <MudText>
            Was ich noch sagen möchte:
        </MudText>
        <MudTextField ReadOnly="@IsReadOnly" @bind-Value="EntityWithFiles.Item.Message" Label="@L["Message"]" Variant="Variant.Outlined" Lines="3" UserAttributes="@(new Dictionary<string, object> { { "data-testid", "message" } })" />
        <ValidationMessage For="@(() => EntityWithFiles.Item.Message)" />
    </MudItem>
</MudPaper>


@code {
    private GenericDtoService<SaveChickenActionDto, SaveChickenActionSearch>? _saveChickenActionService;
    private SaveChickenActionDto? _saveChickenActionDto;
    private DateOnly? minDate =>
    _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
        ? _saveChickenActionDto.Dates.Min()
        : null;

    private DateOnly? maxDate =>
    _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
        ? _saveChickenActionDto.Dates.Max()
        : null;

    protected override async Task OnInitializedAsync()
    {
        _saveChickenActionService = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();
        await getSaveChickenAction();
    }

    private async Task getSaveChickenAction()
    {
        if(_saveChickenActionService == null)
        {
            return;
        }

        if (EntityWithFiles.Item.SaveChickenActionId.HasValue)
        {
            _saveChickenActionDto = await _saveChickenActionService.GetByIdAsync(EntityWithFiles.Item.SaveChickenActionId.Value);
        }
    }

    private async Task OnSaveChickenActionIdChanged(int? newId)
    {
        EntityWithFiles.Item.SaveChickenActionId = newId;
        await getSaveChickenAction();
        StateHasChanged();
    }
}
