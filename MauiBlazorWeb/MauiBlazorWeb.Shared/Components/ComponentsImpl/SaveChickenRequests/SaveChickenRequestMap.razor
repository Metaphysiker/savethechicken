@using MauiBlazorWeb.Shared.Classes
@using global::Shared.Dtos.DtosImpl

<OpenStreetMap Markers="markers" />

@code {
    [Parameter, EditorRequired]
    public List<SaveChickenRequestDto> saveChickenRequestDtos { get; set; } = new();

    private List<MapMarker> markers = new();

    protected override void OnParametersSet()
    {
        DrawMarkers();
    }

    private void DrawMarkers()
    {
        markers = new List<MapMarker>();
        foreach (var dto in saveChickenRequestDtos)
        {
            if (dto.Person?.Address != null && dto.Person.Address.GeoCoordinate != null)
            {
                var marker = new MapMarker
                {
                    Latitude = dto.Person.Address.GeoCoordinate.Latitude,
                    Longitude = dto.Person.Address.GeoCoordinate.Longitude,
                    Info = $"{dto.Person.Contact?.FirstName} {dto.Person.Contact?.LastName}"
                };
                markers.Add(marker);
            }
        }
    }

}
