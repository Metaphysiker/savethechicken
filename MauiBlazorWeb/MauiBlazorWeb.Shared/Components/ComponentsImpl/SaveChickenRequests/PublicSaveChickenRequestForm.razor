@using MauiBlazorWeb.Shared.Components.ComponentsImpl.FileUploads
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.MultiDateSelecters
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@inject IStringLocalizer<AppResources> L
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject SaveChickenActionService SaveChickenActionService

@code {
    [Parameter, EditorRequired]
    public ItemWithBrowserFiles<SaveChickenRequestPublicDto> EntityWithFiles { get; set; } = default!;

    [Parameter]
    public EventCallback OnSubmitSuccess { get; set; }

    private bool isSubmitting = false;
    private SaveChickenActionDto? _saveChickenActionDto;

    private DateOnly? minDate =>
        _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
            ? _saveChickenActionDto.Dates.Min()
            : null;

    private DateOnly? maxDate =>
        _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
            ? _saveChickenActionDto.Dates.Max()
            : null;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    [Inject]
    private AwsFileService AwsFileService { get; set; } = default!;

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        try
        {
            // Upload files first
            var storedFiles = new List<StoredFileDto>();
            foreach (var file in EntityWithFiles.Files)
            {
                var key = await AwsFileService.UploadFileAsync(file);
                if (!string.IsNullOrEmpty(key))
                {
                    storedFiles.Add(new StoredFileDto
                    {
                        FileName = file.Name,
                        FileKey = key,
                        ContentType = file.ContentType
                    });
                }
            }
            if (EntityWithFiles.Item.Files == null)
                EntityWithFiles.Item.Files = new List<StoredFileDto>();
            EntityWithFiles.Item.Files.AddRange(storedFiles);

            var response = await HttpClient.PostAsJsonAsync("api/SaveChickenRequest/public", EntityWithFiles.Item);

            if (response.IsSuccessStatusCode)
            {
                await OnSubmitSuccess.InvokeAsync();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Fehler beim Senden der Anfrage: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ein Fehler ist aufgetreten: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<MudPaper Class="pa-6 my-6" Elevation="6">

    <EditForm Model="EntityWithFiles.Item" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <!-- Kontakt -->
        <MudText Typo="Typo.h6" Class="mb-2 mt-4">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="me-1" /> Kontaktdaten
        </MudText>
        <MudDivider Class="mb-3" />
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EntityWithFiles.Item.FirstName" Label="Vorname*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-firstname" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.FirstName)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EntityWithFiles.Item.LastName" Label="Nachname*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-lastname" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.LastName)" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EntityWithFiles.Item.Email" Label="E-Mail*" Variant="Variant.Outlined" InputType="InputType.Email"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-email" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.Email)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EntityWithFiles.Item.PhoneNumber" Label="Telefonnummer*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-phone" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.PhoneNumber)" />
            </MudItem>
        </MudGrid>

        <!-- Adresse -->
        <MudText Typo="Typo.h6" Class="mb-2 mt-5">
            <MudIcon Icon="@Icons.Material.Filled.Home" Class="me-1" /> Adresse
        </MudText>
        <MudDivider Class="mb-3" />
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EntityWithFiles.Item.City" Label="Ort*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-city" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.City)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EntityWithFiles.Item.PostalCode" Label="PLZ*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-postalcode" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.PostalCode)" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="EntityWithFiles.Item.Street" Label="Strasse und Hausnummer*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-street" })" />
                <ValidationMessage For="@(() => EntityWithFiles.Item.Street)" />
            </MudItem>
        </MudGrid>

        <!-- Angebot -->
        <MudText Typo="Typo.h6" Class="mb-2 mt-5">
            <MudIcon Icon="@Icons.Material.Filled.Egg" Class="me-1" /> Ihr Angebot
        </MudText>
        <MudDivider Class="mb-3" />
        <MudItem Class="mb-3">
            <MudNumericField T="int" @bind-Value="EntityWithFiles.Item.NumberOfChickensToBeSaved" Label="Anzahl Hühner"
                            Variant="Variant.Outlined" Min="0"
                            UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "chickens-count" })" />
            <ValidationMessage For="@(() => EntityWithFiles.Item.NumberOfChickensToBeSaved)" />
        </MudItem>
        <MudItem Class="mb-3">
            <MudNumericField T="int" @bind-Value="EntityWithFiles.Item.NumberOfRoostersToBeSaved" Label="Anzahl Hähne"
                            Variant="Variant.Outlined" Min="0"
                            UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "roosters-count" })" />
            <ValidationMessage For="@(() => EntityWithFiles.Item.NumberOfRoostersToBeSaved)" />
        </MudItem>
        <MudDivider Class="my-4" />
        <MudItem Class="mb-3">
            <MudText Class="mb-2">
                Bitte beschreiben Sie kurz Ihr Hühnerzuhause (Stall, Auslauf m², Anzahl bestehende Hühner, Erfahrung etc.)*
            </MudText>
            <MudTextField @bind-Value="EntityWithFiles.Item.DescriptionOfPlaceForChickens" Label="Beschreibung"
                         Variant="Variant.Outlined" Lines="4"
                         UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "description" })" />
            <ValidationMessage For="@(() => EntityWithFiles.Item.DescriptionOfPlaceForChickens)" />
        </MudItem>
        <MudItem Class="mb-3" Elevation="2">
             <MudText Class="mb-2">Bitte laden Sie Bilder von Ihrem Hühnerzuhause hoch (Stall, Auslauf, etc.)</MudText>
             <FilesUploadForm @bind-Value="EntityWithFiles.Files" Label="Bilder hochladen" Text="Bitte Bilder vom Hühnerzuhause hochladen" />
        </MudItem>
        <MudItem Class="mb-3">
            <MudCheckBox @bind-Value="EntityWithFiles.Item.AlreadyReceivedChickenPreviously"
                        Label="Ich habe bereits zuvor Hühner aufgenommen"
                        UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "received-chickens-before" })" />
            <ValidationMessage For="@(() => EntityWithFiles.Item.AlreadyReceivedChickenPreviously)" />
        </MudItem>

        <!-- Action Selector (hidden, auto-selected) -->
        @if (_saveChickenActionDto != null)
        {
            <input type="hidden" @bind="EntityWithFiles.Item.SaveChickenActionId" />
        }

        <!-- Bedingungen -->
        <MudText Typo="Typo.h6" Class="mb-2 mt-5">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="me-1" /> Bedingungen
        </MudText>
        <MudDivider Class="mb-3" />
        <MudItem Class="mb-3">
            <MudCheckBox @bind-Value="EntityWithFiles.Item.ConfirmThatIFulfillCriteria"
                        Label="Ich bestätige, dass ich die Voraussetzungen erfülle und die Hühnerhaltung ohne Einschränkung in mein Leben passt!"
                        UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "confirm-criteria" })" />
            <ValidationMessage For="@(() => EntityWithFiles.Item.ConfirmThatIFulfillCriteria)" />
        </MudItem>
        <MudItem Class="mb-3">
            <MudCheckBox @bind-Value="EntityWithFiles.Item.AcceptTermsAndConditions"
                        UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "accept-terms" })">
                <ChildContent>
                    Ich akzeptiere die <a href="https://www.rettetdashuhn.ch/j/privacy" target="_blank" rel="noopener">Datenschutzerklärung</a>
                </ChildContent>
            </MudCheckBox>
            <ValidationMessage For="@(() => EntityWithFiles.Item.AcceptTermsAndConditions)" />
        </MudItem>
        <MudDivider Class="my-4" />
        <MudItem Class="mb-3">
            <MudText Class="mb-2">Was ich noch sagen möchte (Motivation Hühner aufzunehmen, Farbwünsche, Hähne willkommen, etc.):</MudText>
            <MudTextField @bind-Value="EntityWithFiles.Item.Message" Label="Nachricht" Variant="Variant.Outlined" Lines="3"
                         UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "message" })" />
            <ValidationMessage For="@(() => EntityWithFiles.Item.Message)" />
        </MudItem>

        <!-- Submit Button -->
        <MudButton ButtonType="ButtonType.Submit"
                  Variant="Variant.Filled"
                  Color="Color.Primary"
                  Size="Size.Large"
                  Disabled="isSubmitting"
                  FullWidth="true"
                  data-testid="submit-button">
            @if (isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span class="ml-2">Wird gesendet...</span>
            }
            else
            {
                <span>Anfrage absenden</span>
            }
        </MudButton>
    </EditForm>
</MudPaper>
