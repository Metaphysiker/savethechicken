@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.MultiDateSelecters
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@inject IStringLocalizer<AppResources> L
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject SaveChickenActionService SaveChickenActionService

@code {
    [Parameter, EditorRequired]
    public SaveChickenRequestPublicDto Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnSubmitSuccess { get; set; }

    private bool isSubmitting = false;
    private SaveChickenActionDto? _saveChickenActionDto;

    private DateOnly? minDate =>
        _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
            ? _saveChickenActionDto.Dates.Min()
            : null;

    private DateOnly? maxDate =>
        _saveChickenActionDto != null && _saveChickenActionDto.Dates != null && _saveChickenActionDto.Dates.Count > 0
            ? _saveChickenActionDto.Dates.Max()
            : null;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("api/SaveChickenRequest/public", Model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Vielen Dank! Ihre Anfrage wurde erfolgreich gesendet.", Severity.Success);
                await OnSubmitSuccess.InvokeAsync();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Fehler beim Senden der Anfrage: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ein Fehler ist aufgetreten: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <!-- Contact Information -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Ihre Kontaktdaten</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.FirstName" Label="Vorname*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-firstname" })" />
                <ValidationMessage For="@(() => Model.FirstName)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.LastName" Label="Nachname*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-lastname" })" />
                <ValidationMessage For="@(() => Model.LastName)" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.Email" Label="E-Mail*" Variant="Variant.Outlined" InputType="InputType.Email"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-email" })" />
                <ValidationMessage For="@(() => Model.Email)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.PhoneNumber" Label="Telefonnummer*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "contact-phone" })" />
                <ValidationMessage For="@(() => Model.PhoneNumber)" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Address Information -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Ihre Adresse</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.City" Label="Ort*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-city" })" />
                <ValidationMessage For="@(() => Model.City)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Model.PostalCode" Label="PLZ*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-postalcode" })" />
                <ValidationMessage For="@(() => Model.PostalCode)" />
            </MudItem>
        </MudGrid>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Street" Label="Strasse und Hausnummer*" Variant="Variant.Outlined"
                              UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "address-street" })" />
                <ValidationMessage For="@(() => Model.Street)" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- SaveChickenRequest Details -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Informationen zu Ihrem Angebot</MudText>

        <MudItem Class="mb-3">
            <MudNumericField T="int" @bind-Value="Model.NumberOfChickensToBeSaved" Label="Anzahl Hühner"
                            Variant="Variant.Outlined" Min="0"
                            UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "chickens-count" })" />
            <ValidationMessage For="@(() => Model.NumberOfChickensToBeSaved)" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudNumericField T="int" @bind-Value="Model.NumberOfRoostersToBeSaved" Label="Anzahl Hähne"
                            Variant="Variant.Outlined" Min="0"
                            UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "roosters-count" })" />
            <ValidationMessage For="@(() => Model.NumberOfRoostersToBeSaved)" />
        </MudItem>

        <MudDivider Class="my-4" />

        <MudItem Class="mb-3">
            <MudText Class="mb-2">
                Bitte beschreiben Sie kurz Ihr Hühnerzuhause (Stall, Auslauf m², Anzahl bestehende Hühner, Erfahrung etc.)*
            </MudText>
            <MudTextField @bind-Value="Model.DescriptionOfPlaceForChickens" Label="Beschreibung"
                         Variant="Variant.Outlined" Lines="4"
                         UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "description" })" />
            <ValidationMessage For="@(() => Model.DescriptionOfPlaceForChickens)" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudCheckBox @bind-Value="Model.AlreadyReceivedChickenPreviously"
                        Label="Ich habe bereits zuvor Hühner aufgenommen"
                        UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "received-chickens-before" })" />
            <ValidationMessage For="@(() => Model.AlreadyReceivedChickenPreviously)" />
        </MudItem>
    </MudPaper>

    <!-- Action Selector (hidden, auto-selected) -->
    @if (_saveChickenActionDto != null)
    {
        <input type="hidden" @bind="Model.SaveChickenActionId" />
    }

    <!-- Terms and Conditions -->
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudItem Class="mb-3">
            <MudCheckBox @bind-Value="Model.ConfirmThatIFulfillCriteria"
                        Label="Ich bestätige, dass ich die Kriterien für die Aufnahme von Hühnern erfülle*"
                        UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "confirm-criteria" })" />
            <ValidationMessage For="@(() => Model.ConfirmThatIFulfillCriteria)" />
        </MudItem>

        <MudItem Class="mb-3">
            <MudCheckBox @bind-Value="Model.AcceptTermsAndConditions"
                        Label="Ich akzeptiere die Allgemeinen Geschäftsbedingungen*"
                        UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "accept-terms" })" />
            <ValidationMessage For="@(() => Model.AcceptTermsAndConditions)" />
        </MudItem>

        <MudDivider Class="my-4" />

        <MudItem Class="mb-3">
            <MudText Class="mb-2">Was ich noch sagen möchte:</MudText>
            <MudTextField @bind-Value="Model.Message" Label="Nachricht" Variant="Variant.Outlined" Lines="3"
                         UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "message" })" />
            <ValidationMessage For="@(() => Model.Message)" />
        </MudItem>
    </MudPaper>

    <!-- Submit Button -->
    <MudButton ButtonType="ButtonType.Submit"
              Variant="Variant.Filled"
              Color="Color.Primary"
              Size="Size.Large"
              Disabled="isSubmitting"
              FullWidth="true"
              data-testid="submit-button">
        @if (isSubmitting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <span class="ml-2">Wird gesendet...</span>
        }
        else
        {
            <span>Anfrage absenden</span>
        }
    </MudButton>
</EditForm>
