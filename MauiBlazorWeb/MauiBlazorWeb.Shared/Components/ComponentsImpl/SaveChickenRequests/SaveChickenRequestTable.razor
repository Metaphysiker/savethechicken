@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.StoredFiles
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using MudBlazor
@using MudBlazor.Components
@using global::Shared.Dtos.DtosImpl
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppResources> L

@code {
    [Parameter]
    public List<SaveChickenRequestDto> items { get; set; } = new List<SaveChickenRequestDto>();

    [Parameter] public EventCallback<SaveChickenRequestDto> OnItemSelected { get; set; }
    void SelectItem(SaveChickenRequestDto item) => OnItemSelected.InvokeAsync(item);

    [Parameter] public EventCallback<(string? SortBy, bool? SortDescending)> OnSortSelected { get; set; }
    void SortByColumn(string columnName, bool? descending) => OnSortSelected.InvokeAsync((columnName, descending));

    [Parameter] public EventCallback OnItemsChanged { get; set; }

    private string? currentColumnName = null;
    private bool? currentSortDescending = null;

    private void OnHeaderClick(string columnName)
    {
        bool? descending = currentColumnName == columnName ? !currentSortDescending : false;
        currentColumnName = columnName;
        currentSortDescending = descending;
        SortByColumn(columnName, descending);
    }

    private string? GetSortIcon(string columnName)
    {
        if (currentColumnName != columnName) return null;
        return currentSortDescending == true ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;
    }

    private void EditItem(SaveChickenRequestDto saveChickenRequestDto)
    {
        NavigationManager.NavigateTo($"/save-chicken-requests/{saveChickenRequestDto.Id}/edit");

    }

    private string GetRowClass(SaveChickenRequestDto item, int rowNumber)
    {
        // Example: highlight if there are any blacklisted person IDs
        return item.BlackListedPersonIds != null && item.BlackListedPersonIds.Any()
            ? "row-blacklisted"
            : string.Empty;
    }
}

<div style="overflow-x: auto; max-width: 100%;">
    <MudDataGrid Items="@items" Hover="true" Dense="true" Striped="true" Bordered="true" SortMode="SortMode.None" RowClassFunc="GetRowClass">
    <Columns>
        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.FirstName"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Contact_FirstName"]
                        @if (GetSortIcon("Person.Contact.FirstName") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.FirstName")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.FirstName</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.LastName"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Contact_LastName"]
                        @if (GetSortIcon("Person.Contact.LastName") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.LastName")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.LastName</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Person.Address.Street"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Address_Street"]
                        @if (GetSortIcon("Person.Address.Street") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Address.Street")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Address?.Street</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Address.City"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Address_City"]
                        @if (GetSortIcon("Person.Address.City") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Address.City")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Address?.City</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Address.PostalCode"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Address_PostalCode"]
                        @if (GetSortIcon("Person.Address.PostalCode") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Address.PostalCode")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Address?.PostalCode</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.PhoneNumber"))" Variant="Variant.Text" Style="text-transform: none;">
                    @L["Contact_Phone"]
                        @if (GetSortIcon("Person.Contact.PhoneNumber") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.PhoneNumber")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.PhoneNumber</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Person.Contact.Email"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Contact_Email"]
                        @if (GetSortIcon("Person.Contact.Email") != null)
                    {
                            <MudIcon Icon="@GetSortIcon("Person.Contact.Email")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Person?.Contact?.Email</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("NumberOfChickensToBeSaved"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["NumberOfChickensToBeSaved"]
                    @if (GetSortIcon("NumberOfChickensToBeSaved") != null)
                    {
                        <MudIcon Icon="@GetSortIcon("NumberOfChickensToBeSaved")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.NumberOfChickensToBeSaved</CellTemplate>
        </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("NumberOfRoostersToBeSaved"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["NumberOfRoostersToBeSaved"]
                        @if (GetSortIcon("NumberOfRoostersToBeSaved") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("NumberOfRoostersToBeSaved")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>@context.Item.NumberOfRoostersToBeSaved</CellTemplate>
            </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("DescriptionOfPlaceForChickens"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["DescriptionOfPlaceForChickens"]
                    @if (GetSortIcon("DescriptionOfPlaceForChickens") != null)
                    {
                        <MudIcon Icon="@GetSortIcon("DescriptionOfPlaceForChickens")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.DescriptionOfPlaceForChickens</CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("Message"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Message"]
                    @if (GetSortIcon("Message") != null)
                    {
                        <MudIcon Icon="@GetSortIcon("Message")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>@context.Item.Message</CellTemplate>
        </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("SaveChickenActionId"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["SaveChickenAction"]
                        @if (GetSortIcon("SaveChickenActionId") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("SaveChickenActionId")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>
                    @{
                        var action = context.Item.SaveChickenAction;
                        var actionId = context.Item.SaveChickenActionId;
                    }
                    @(action?.Title ?? actionId?.ToString() ?? string.Empty)
                </CellTemplate>
            </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                <MudButton OnClick="@(() => OnHeaderClick("DatesForHandOver"))" Variant="Variant.Text" Style="text-transform: none;">
                    @L["DatesForHandOver"]
                    @if (GetSortIcon("DatesForHandOver") != null)
                    {
                        <MudIcon Icon="@GetSortIcon("DatesForHandOver")" Size="Size.Small" />
                    }
                </MudButton>
            </HeaderTemplate>
            <CellTemplate>
                @string.Join(", ", context.Item.DatesForHandOver.Select(d => d.ToString("dd.MM.yyyy")))
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn>
            <HeaderTemplate>
                    @L["Files"]
            </HeaderTemplate>
            <CellTemplate>
                @foreach (var file in context.Item.Files)
                {
                    <StoredFileDialog StoredFile="file" />
                }
            </CellTemplate>
        </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>
                    @L["BlackListedPersonIds"]
                </HeaderTemplate>
                <CellTemplate>
                    @foreach (var id in context.Item.BlackListedPersonIds)
                    {
                        <MudChip>@id</MudChip>
                    }

                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["copy"]</HeaderTemplate>
                <CellTemplate>
                    @if (context.Item != null)
                    {
                        <SaveChickenActionSelectorDialogLauncher TDto="SaveChickenRequestDto"
                                                                 Model="context.Item"
                                                                 OnCopied="@(() => OnItemsChanged.InvokeAsync())"
                                                                 ExcludeIds="@(context.Item.SaveChickenActionId.HasValue ? new List<int> { context.Item.SaveChickenActionId.Value } : null)" />
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["edit"]</HeaderTemplate>
                <CellTemplate>
                    @if (context.Item != null)
                    {
                        var itemWithFiles = new ItemWithBrowserFiles<SaveChickenRequestDto> { Item = context.Item };
                        <GenericUpdateWithFilesDialogLauncher TDto="SaveChickenRequestDto"
                                                        model="itemWithFiles"
                                                        OnEdited="@(() => OnItemsChanged.InvokeAsync())">
                            <ChildContent Context="editModel">
                                <SaveChickenRequestFormWithFiles EntityWithFiles="editModel" />
                            </ChildContent>
                        </GenericUpdateWithFilesDialogLauncher>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn>
                <HeaderTemplate>@L["delete"]</HeaderTemplate>
                <CellTemplate>
                    <GenericDeleteDialog TDto="SaveChickenRequestDto"
                                         Model="context.Item"
                                         OnDeleted="@(() => OnItemsChanged.InvokeAsync())" />
                </CellTemplate>
            </TemplateColumn>
    </Columns>
</MudDataGrid>
</div>
