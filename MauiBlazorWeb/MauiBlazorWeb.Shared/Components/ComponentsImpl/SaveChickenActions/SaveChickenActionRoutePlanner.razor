@using MauiBlazorWeb.Shared.Classes
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@inject GenericDtoServiceFactory DtoServiceFactory


<MudPaper Class="pa-4 my-4" Elevation="2">
    <MudText Typo="Typo.h3">Routen-Planer</MudText>

    <MudDropContainer T="DropItem"
                      Items="_items"
                      ItemsSelector="@((item, dropzone) => item.Selector == dropzone)"
                      ItemDropped="ItemUpdated"
                      Class="d-flex flex-column">
        <ChildContent>
            @foreach (var date in uniqueDates)
            {
                @foreach (var farm in GetFarmByDate(date))
                {
                    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Betrieb: @farm.Name, Datum: @date.ToString("dd.MM.yyyy")</MudText>

                    @foreach (var drivePlan in GetDriversByDateAndFarm(date, farm))
                    {
                        <MudText Typo="Typo.h6">Fahrt: #@drivePlan.NumberOfDrive - Fahrer: @drivePlan.Driver.Contact.FirstName @drivePlan.Driver.Contact.LastName, Kapazität: @drivePlan.Driver.CapacityForChickens</MudText>

                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudPaper Class="ma-4 flex-grow-1">
                                    @foreach(var request in drivePlan.SaveChickenRequests)
                                    {
                                        <MudText>@request.Contact.FirstName @request.Contact.LastName, @request.Address.Street, @request.Address.PostalCode @request.Address.City, @request.NumberOfChickensToBeSaved Hühner, @request.NumberOfRoostersToBeSaved Hähne</MudText>
                                    }
            
                                    <MudList T="DropItem" Class="d-flex flex-column mud-height-full">
                                        <MudDropZone T="DropItem" Identifier="@drivePlan.Id.ToString()" Class="flex-grow-1 always-dropzone" AllowReorder="true" />
                                        @if (!_items.Any(i => i.Selector == drivePlan.Id.ToString()))
                                        {
                                            <div class="empty-dropzone-placeholder">Hier ablegen</div>
                                        }
                                    </MudList>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <OpenStreetMap markers="drivePlan.RouteMarkers" arrows="drivePlan.RouteArrows" />

                            </MudItem>
                        </MudGrid>
                        <MudDivider></MudDivider>
                    }
                }
                <MudDivider Class="my-2" Style="border-color: red; border-width: 3px;" />
            }

            <!-- Unassigned dropzone -->
            <MudPaper Class="ma-4 flex-grow-1">
                <MudList T="DropItem" Class="d-flex flex-column mud-height-full">
                    <MudListSubheader>Ablage</MudListSubheader>
                    <MudDropZone T="DropItem" Identifier="unassigned" Class="flex-grow-1" AllowReorder="true" />
                </MudList>
            </MudPaper>
        </ChildContent>

        <ItemRenderer>
            <MudPaper Class="pa-2 ma-1" Elevation="1">
                <MudGrid Class="item-table-grid" Style="width:100%;">
                    <MudItem xs="12" md="4" Class="item-table-cell">
                        @context.Name
                    </MudItem>
                    <MudItem xs="12" md="5" Class="item-table-cell">
                        @context.saveChickenRequest.Address.PostalCode @context.saveChickenRequest.Address.City, @context.saveChickenRequest.Address.Street
                    </MudItem>
                    <MudItem xs="12" md="3" Class="item-table-cell">
                        @context.saveChickenRequest.NumberOfChickensToBeSaved Hühner, @context.saveChickenRequest.NumberOfRoostersToBeSaved Hähne
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>
</MudPaper>
@code {
    List<DrivePlan> drivePlans = new();
    HashSet<DateOnly> uniqueDates = new();

    [Parameter, EditorRequired]
    public SaveChickenActionDto saveChickenActionDto { get; set; } = default!;

    public List<DriverDto> Drivers { get; set; } = new();

    public List<FarmDto> Farms { get; set; } = new();

    public List<SaveChickenRequestDto> SaveChickenRequests { get; set; } = new();

    private GenericDtoService<SaveChickenActionDto, SaveChickenActionSearch>? _saveChickenActionService;
    private GenericDtoService<SaveChickenRequestDto, SaveChickenRequestSearch>? _saveChickenRequestService;
    private GenericDtoService<DriverDto, DriverSearch>? _driverService;
    private GenericDtoService<FarmDto, FarmSearch>? _farmService;

    protected override void OnInitialized()
    {
        _saveChickenActionService = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();
        _driverService = DtoServiceFactory.Create<DriverDto, DriverSearch>();
        _farmService = DtoServiceFactory.Create<FarmDto, FarmSearch>();
        _saveChickenRequestService = DtoServiceFactory.Create<SaveChickenRequestDto, SaveChickenRequestSearch>();
    }

    private void ItemUpdated(MudItemDropInfo<DropItem> dropItem)
    {
        if (dropItem.Item == null || dropItem.Item.saveChickenRequest == null)
            return;

        // Identify source and target drive plans
        var targetDrivePlan = drivePlans.FirstOrDefault(p => p.Id.ToString() == dropItem.DropzoneIdentifier);
        var sourceDrivePlan = drivePlans.FirstOrDefault(p =>
            p.SaveChickenRequests.Any(r => r.Id == dropItem.Item.saveChickenRequest.Id));

        // Prevent moving between different dates
        if (targetDrivePlan != null && sourceDrivePlan != null &&
            targetDrivePlan.RouteDate != sourceDrivePlan.RouteDate)
            return;

        // Remove from source list
        if (sourceDrivePlan != null)
        {
            sourceDrivePlan.SaveChickenRequests.RemoveAll(r => r.Id == dropItem.Item.saveChickenRequest.Id);
        }

        // Insert into target list at drop index
        if (targetDrivePlan != null)
        {
            // Remove duplicates if any
            targetDrivePlan.SaveChickenRequests.RemoveAll(r => r.Id == dropItem.Item.saveChickenRequest.Id);

            int index = dropItem.IndexInZone;
            if (index >= 0 && index <= targetDrivePlan.SaveChickenRequests.Count)
            {
                targetDrivePlan.SaveChickenRequests.Insert(index, dropItem.Item.saveChickenRequest);
            }
            else
            {
                targetDrivePlan.SaveChickenRequests.Add(dropItem.Item.saveChickenRequest);
            }
        }

        // Update selector for UI
        dropItem.Item.Selector = dropItem.DropzoneIdentifier;

        // Rebuild markers and arrows
        setMap();
    }



    private List<DropItem> _items = new();

    public class DropItem
    {
        public string Name { get; init; }
        public string Selector { get; set; }
        public SaveChickenRequestDto saveChickenRequest { get; set; }
    }

    private async Task GetAndSetDriversRequestsAndFarms()
    {
        if(_driverService == null || _saveChickenRequestService == null || _farmService == null)
        {
            return;
        }

        var pageSize = 5;

        var driverSearch = new DriverSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var driverResults = await _driverService.SearchAsync(driverSearch);
        Drivers = driverResults.Data;

        var saveChickenRequestSearch = new SaveChickenRequestSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var saveChickenRequestResults = await _saveChickenRequestService.SearchAsync(saveChickenRequestSearch);
        SaveChickenRequests = saveChickenRequestResults.Data;

        var farmSearch = new FarmSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var farmResults = await _farmService.SearchAsync(farmSearch);
        Farms = farmResults.Data;
    }

    // Change the return type from async Task to void and use async void for the override
    protected override async Task OnParametersSetAsync()
    {
        await GetAndSetDriversRequestsAndFarms();

        PlanRoutes();

        _items.Clear();

        foreach (var drivePlan in drivePlans)
        {
            foreach (var request in drivePlan.SaveChickenRequests)
            {
                _items.Add(new DropItem
                {
                    Name = $"{request.Contact.FirstName} {request.Contact.LastName}",
                    Selector = drivePlan.Id.ToString(),
                    saveChickenRequest = request
                });
            }
        }

        StateHasChanged();
    }

    public HashSet<DateOnly> GetAllUniqueRescueDates(IEnumerable<FarmDto> farms)
    {
        return farms
            .Where(f => f.DatesForRescues != null)
            .SelectMany(f => f.DatesForRescues)
            .ToHashSet();
    }

    private void PlanRoutes()
    {
        drivePlans.Clear();
        var copyOfRequests = new List<SaveChickenRequestDto>(SaveChickenRequests);
        uniqueDates = GetAllUniqueRescueDates(Farms);

        @foreach(var date in uniqueDates)
        {
            @foreach(var farm in Farms)
            {

                if(!farm.DatesForRescues.Contains(date))
                    continue;

            var saveChickenRequestsForDate = copyOfRequests
                .Where(r => r.DatesForHandOver.Contains(date))
                .ToList();

            var sortedRequests = saveChickenRequestsForDate
                .Where(r => r.Address != null && !string.IsNullOrWhiteSpace(r.Address.PostalCode))
                .OrderBy(r => r.Address.PostalCode)
                .ToList();

            var driversForDate = Drivers.Where(d => d.AvailableDates.Contains(date)).ToList();

            var driversCount = driversForDate.Count;

            if (driversCount == 0)
                continue;

            if(sortedRequests.Count == 0)
                continue;

                var currentDriverIndex = 0;
                DrivePlan? currentDrivePlan = null;

                for (int i = 0; i < sortedRequests.Count; i++)
                {
                    var driver = driversForDate[currentDriverIndex];

                    var sumOfAnimalsInCurrentRoute = currentDrivePlan != null
                        ? currentDrivePlan.SaveChickenRequests.Sum(r => r.NumberOfChickensToBeSaved + r.NumberOfRoostersToBeSaved)
                        : 0;

                    var totalAnimals = sortedRequests[i].NumberOfChickensToBeSaved + sortedRequests[i].NumberOfRoostersToBeSaved + sumOfAnimalsInCurrentRoute;
                    if(totalAnimals > driver.CapacityForChickens)
                    {
                        // If the current driver can't take all animals, move to the next driver
                        currentDriverIndex = (currentDriverIndex + 1) % driversCount;
                        driver = driversForDate[currentDriverIndex];
                        currentDrivePlan = null; // Reset current drive plan for the new driver
                    }

                    var request = sortedRequests[i];

                    if (currentDrivePlan == null)
                    {
                        int NumberOfDrive = drivePlans.Count();
                        currentDrivePlan = new DrivePlan { Driver = driver, SaveChickenRequests = new List<SaveChickenRequestDto>(), RouteDate = date, Farm = farm, NumberOfDrive = NumberOfDrive };
                        drivePlans.Add(currentDrivePlan);
                    }
                    // Only add request if not already present in any routePlan
                    if (!drivePlans.Any(drp => drp.SaveChickenRequests.Any(r => r.Id == request.Id)))
                    {
                        currentDrivePlan.SaveChickenRequests.Add(request);
                    }
                }
            }
        }

        setMap();
    }

    private void setMap()
    {
        setMapMarkers();
        SetMapArrows();
        StateHasChanged();
    }

    private List<FarmDto> GetFarmByDate(DateOnly date)
    {
        return Farms.Where(f => f.DatesForRescues.Contains(date)).ToList();
    }

    private List<DrivePlan> GetDriversByDateAndFarm(DateOnly date, FarmDto farm)
    {
        return drivePlans
            .Where(drp => drp.RouteDate == date && drp.Farm.Id == farm.Id)
            .ToList();
    }

    private void setMapMarkers()
    {
        foreach(var drivePlan in drivePlans)
        {
            // Clear existing markers to prevent duplicates
            drivePlan.RouteMarkers.Clear();

            //first marker is farm
            var farmMarker = new MapMarker
                {
                    Latitude = drivePlan.Farm.Address.GeoCoordinate.Latitude,
                    Longitude = drivePlan.Farm.Address.GeoCoordinate.Longitude,
                    Info = $"Start: {drivePlan.Farm.Name}"
                };

            drivePlan.RouteMarkers.Add(farmMarker);

            // Logic to set map markers for each driver's route based on their assigned SaveChickenRequests
            foreach (var request in drivePlan.SaveChickenRequests)
            {
                if (request.Address?.GeoCoordinate != null)
                {
                    var marker = new MapMarker
                    {
                        Latitude = request.Address.GeoCoordinate.Latitude,
                        Longitude = request.Address.GeoCoordinate.Longitude,
                        Info = $"{request.Contact.FirstName} {request.Contact.LastName}, {request.Address.Street}, {request.Address.PostalCode} {request.Address.City}, {request.NumberOfChickensToBeSaved} Hühner, {request.NumberOfRoostersToBeSaved} Hähne"
                    };
                    drivePlan.RouteMarkers.Add(marker);
                }
            }
        }
    }

    private void SetMapArrows()
    {

        // Logic to set map arrows for routes, skipping the last marker (no arrow from last to nowhere)
        foreach (var drivePlan in drivePlans)
        {
            drivePlan.RouteArrows.Clear();
            int markerCount = drivePlan.RouteMarkers.Count;
            if (markerCount < 2)
                continue;
            // Only set arrows up to the second-to-last marker
            for (int i = 0; i < markerCount - 1; i++)
            {
                var fromMarker = drivePlan.RouteMarkers[i];
                var toMarker = drivePlan.RouteMarkers[i + 1];
                var arrow = new MapArrow
                {
                    LatitudeFrom = fromMarker.Latitude,
                    LongitudeFrom = fromMarker.Longitude,
                    LatitudeTo = toMarker.Latitude,
                    LongitudeTo = toMarker.Longitude,
                };
                drivePlan.RouteArrows.Add(arrow);
            }
        }
    }
}
<style>
    .always-dropzone {
    min-height: 64px;
}

.empty-dropzone-placeholder {
    color: #bbb;
    text-align: center;
    padding: 16px 0;
    font-style: italic;
    pointer-events: none;
    margin-top: -48px; /* adjust if needed to center text in dropzone */
    z-index: 1;
    position: relative;
}
</style>