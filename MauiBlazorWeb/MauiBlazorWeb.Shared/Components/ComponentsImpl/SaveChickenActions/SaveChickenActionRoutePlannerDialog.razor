@using global::Shared.Dtos.DtosImpl
@using MudBlazor

<MudDialog>
    <DialogContent>
        <SaveChickenActionRoutePlannerV3 saveChickenActionDto="@SaveChickenActionDto" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">
            Schließen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired]
    public SaveChickenActionDto SaveChickenActionDto { get; set; } = default!;

    void Close() => MudDialog?.Close();
}
