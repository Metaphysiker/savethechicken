@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Addresses
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Contacts
@using global::Shared.Dtos.DtosImpl
@using Microsoft.Extensions.Localization
@using MauiBlazorWeb.Shared.Resources.Strings
@inject IStringLocalizer<AppResources> L
@code {
    [Parameter, EditorRequired] public SaveChickenActionDto Model { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; } = false;
}

<MudPaper Class="pa-4 my-4" Elevation="2">
    <MudTextField ReadOnly="@IsReadOnly"
                  @bind-Value="Model.Title"
                  Label="@L["Title"]"
                  Variant="Variant.Outlined"
                  data-testid="action-title" />
    <ValidationMessage For="@(() => Model.Title)" />
    <MudTextField ReadOnly="@IsReadOnly"
                  @bind-Value="Model.Description"
                  Label="@L["Description"]"
                  Variant="Variant.Outlined"
                  Lines="4"
                  TextFieldStyle="MudBlazor.TextFieldStyle.TextArea"
                  data-testid="action-description" />
    <ValidationMessage For="@(() => Model.Description)" />

    <MudSwitch T="bool" @bind-Value="Model.IsArchived"
        Label="@L["IsArchived"]"
        Disabled="@IsReadOnly"
        Color="Color.Primary"
        Class="mt-4" />
    </MudPaper>

<MauiBlazorWeb.Shared.Components.MultiDateSelecters.MultiDateOnlySelector Text="@L["TransferDates"]" @bind-SelectedDates="Model.Dates" />


