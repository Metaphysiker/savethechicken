@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using global::Shared.Dtos.DtosImpl
@inject IStringLocalizer<AppResources> L

<MudGrid>
    <MudItem xs="9">
        <MudTextField @bind-Value="Model.SearchTerm"
                  Label="@L["Search"]"
                  Variant="Variant.Outlined"
                  Placeholder="@L["SearchPlaceholder"]"
                  Immediate="true"
                  data-testid="search-box" />
    </MudItem>

    <MudItem xs="3" sm="3">
        <MudSelect @bind-Value="Model.IsArchived"
                   Label="@L["ArchivedFilter"]"
                   Variant="Variant.Outlined"
                   Clearable="true">
            <MudSelectItem Value="@((bool?)null)">@L["All"]</MudSelectItem>
            <MudSelectItem Value="@((bool?)true)">@L["ArchivedOnly"]</MudSelectItem>
            <MudSelectItem Value="@((bool?)false)">@L["NotArchived"]</MudSelectItem>
        </MudSelect>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public SaveChickenActionSearch Model { get; set; } = default!;
}
