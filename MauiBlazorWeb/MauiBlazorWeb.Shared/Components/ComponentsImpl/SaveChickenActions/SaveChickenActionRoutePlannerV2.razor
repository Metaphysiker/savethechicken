@using MauiBlazorWeb.Shared.Classes
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Helpers
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject GenericDtoServiceFactory DtoServiceFactory
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 my-4" Elevation="2">
    <MudText Typo="Typo.h3" Class="mb-4">Routen-Planer V2</MudText>

    @* Action buttons *@
    <MudPaper Class="mb-4 pa-3" Elevation="1">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ResetAssignments" Class="mr-2">
            Reset
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAssignments" Disabled="_isSaving" Class="mr-2">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Speichern...</MudText>
            }
            else
            {
                <MudText>Speichern</MudText>
            }
        </MudButton>
    </MudPaper>

    <MudDropContainer T="DropItem" @ref="_dropContainer" Items="_requestItems"
                      ItemsSelector="@((item, dropzone) => item.Selector == dropzone)" ItemDropped="RequestItemDropped">
        <ChildContent>
            <MudGrid>
                @* Column 1: Drivers (click to select, not a dropzone) *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-2" Elevation="2" Style="height: 400px; overflow-y: auto;">
                        <MudText Typo="Typo.h6" Class="mb-2 px-2">Fahrer</MudText>
                        <MudList T="SaveChickenDriveRequestDto" SelectedValue="_selectedDriver"
                                 SelectedValueChanged="SelectDriver">
                            @foreach (var driver in Drivers)
                            {
                                <MudListItem T="SaveChickenDriveRequestDto" Value="@driver">
                                    <MudText>@driver.Person?.Contact?.FirstName @driver.Person?.Contact?.LastName</MudText>
                                    <MudText Typo="Typo.caption">@GetAssignedCount(driver) Angebote</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>

                @* Column 2: Date picker + drop zone for the selected driver's current drive *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-2" Elevation="2" Style="height: 400px; overflow-y: auto;">
                        <MudText Typo="Typo.h6" Class="mb-2 px-2">
                            @(_selectedDriver == null
                                ? "Angebote"
                                : $"Angebote: {_selectedDriver.Person?.Contact?.FirstName}   {_selectedDriver.Person?.Contact?.LastName}")
                        </MudText>
                        @if (_selectedDriver == null)
                        {
                            <MudText Class="px-2" Typo="Typo.body2" Color="Color.Secondary">Wähle einen Fahrer aus.
                            </MudText>
                        }
                        else if (saveChickenActionDto.Dates == null || saveChickenActionDto.Dates.Count == 0)
                        {
                            <MudText Class="px-2" Typo="Typo.body2" Color="Color.Error">
                                Für diese Aktion sind keine Termine definiert.
                            </MudText>
                        }
                        else
                        {
                            <MudSelect T="DateOnly" Value="@(_selectedDriveDate ?? saveChickenActionDto.Dates[0])"
                                       ValueChanged="@(async (DateOnly d) => SelectDriveDate(d))" Label="Fahrt-Termin" Dense="true"
                                       Margin="Margin.Dense" Class="px-2 mb-2">
                                @foreach (var date in saveChickenActionDto.Dates)
                                {
                                    <MudSelectItem T="DateOnly" Value="@date">
                                        @date.ToString("dd.MM.yyyy") (@GetAssignedCountForDrive(_selectedDriver.Id, date)
                                        Angebote)
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudDropZone T="DropItem" Identifier="@(CurrentDriveSelector ?? "unassigned")" Class="pa-2"
                                         AllowReorder="true" Style="min-height: 100px;" />
                        }
                    </MudPaper>
                </MudItem>

                @* Column 3: Unassigned *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-2" Elevation="2" Style="height: 400px; overflow-y: auto;">
                        <MudText Typo="Typo.h6" Class="mb-2 px-2">Nicht zugeordnet</MudText>
                        <MudDropZone T="DropItem" Identifier="unassigned" Class="pa-2" AllowReorder="true"
                                     Style="min-height: 100px;" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </ChildContent>

        <ItemRenderer>
            <DropItemCardForSaveChickenRequest Item="context" />
        </ItemRenderer>
    </MudDropContainer>
@if (_selectedDriver != null && _selectedDriveDate.HasValue)
    {
        <DriverRouteMapCard Driver="_selectedDriver" Date="_selectedDriveDate" Markers="_selectedDriverMarkers" Arrows="_selectedDriverArrows"
                            TotalDistanceKm="_selectedDriverDistanceKm" TotalNumberOfChickens="@GetTotalNumberOfChickens(_selectedDriver)"
                            TotalNumberOfRoosters="@GetTotalNumberOfRoosters(_selectedDriver)" />
    }
</MudPaper>

@code {
    private bool _isLoading = false;
    private bool _isSaving = false;
    private int _lastLoadedActionId = 0;
    private bool _isDisposed = false;
    private CancellationTokenSource? _cancellationTokenSource;

    [Parameter, EditorRequired]
    public SaveChickenActionDto saveChickenActionDto { get; set; } = default!;

    public List<SaveChickenDriveRequestDto> Drivers { get; set; } = new();
    public List<SaveChickenRequestDto> SaveChickenRequests { get; set; } = new();

    private GenericDtoService<SaveChickenActionDto, SaveChickenActionSearch>? _saveChickenActionService;
    private GenericDtoService<SaveChickenRequestDto, SaveChickenRequestSearch>? _saveChickenRequestService;
    private GenericDtoService<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>? _driverService;

    private MudDropContainer<DropItem>? _dropContainer;
    private List<DropItem> _requestItems = new();
    private SaveChickenDriveRequestDto? _selectedDriver;
    private DateOnly? _selectedDriveDate;

    // Key: RequestId. Value: (DriverId, Date, Order) identifying which "drive" (driver + date) the request is assigned to.
    private Dictionary<int, (int DriverId, DateOnly Date, int Order)?> _requestDriverAssignments = new();
    private bool _needsDropRefresh = false;
    private List<MapMarker> _selectedDriverMarkers = new();
    private List<MapArrow> _selectedDriverArrows = new();
    private double _selectedDriverDistanceKm;

    private const string DriveSelectorSeparator = "_";

    /// <summary>
    /// Builds the composite drop-zone identifier for a given driver + date "drive".
    /// </summary>
    private static string BuildDriveSelector(int driverId, DateOnly date)
    {
        return $"{driverId}{DriveSelectorSeparator}{date:yyyyMMdd}";
    }

    /// <summary>
    /// Parses a composite drop-zone identifier back into driver id + date. Returns false for "unassigned" or invalid
    ///values.
    /// </summary>
    private static bool TryParseDriveSelector(string? selector, out int driverId, out DateOnly date)
    {
        driverId = 0;
        date = default;

        if (string.IsNullOrEmpty(selector) || selector == "unassigned")
            return false;

        var parts = selector.Split(DriveSelectorSeparator);
        if (parts.Length != 2)
            return false;

        if (!int.TryParse(parts[0], out driverId))
            return false;

        if (!DateOnly.TryParseExact(parts[1], "yyyyMMdd", out date))
            return false;

        return true;
    }

    /// <summary>
    /// The drop-zone identifier for the drive currently being viewed (selected driver + selected date), if any.
    /// </summary>
    private string? CurrentDriveSelector => _selectedDriver != null && _selectedDriveDate.HasValue
        ? BuildDriveSelector(_selectedDriver.Id, _selectedDriveDate.Value)
        : null;

    protected override void OnInitialized()
    {
        _saveChickenActionService = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();
        _driverService = DtoServiceFactory.Create<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>();
        _saveChickenRequestService = DtoServiceFactory.Create<SaveChickenRequestDto, SaveChickenRequestSearch>();
        _cancellationTokenSource = new CancellationTokenSource();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isDisposed) return;

        if (_isLoading)
            return;

        var currentActionId = saveChickenActionDto?.Id ?? 0;
        var isNewAction = _lastLoadedActionId != currentActionId;

        _isLoading = true;
        try
        {
            await LoadData();
            _lastLoadedActionId = currentActionId;

            if (isNewAction)
            {
                Snackbar.Add("Route-Planer geladen", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Laden: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_needsDropRefresh && _dropContainer != null)
        {
            _needsDropRefresh = false;
            _dropContainer.Refresh();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Loads drivers and requests, restores saved assignments (or starts empty), and builds the drag-and-drop items.
    /// </summary>
    private async Task LoadData()
    {
        if (_isDisposed) return;

        Drivers.Clear();
        SaveChickenRequests.Clear();
        _requestItems = new List<DropItem>();
        _requestDriverAssignments.Clear();
        _selectedDriver = null;
        _selectedDriveDate = null;

        await GetAndSetDriversAndRequests();

        LoadSavedAssignments();

        BuildRequestItems();
        _needsDropRefresh = true;
    }

    private async Task GetAndSetDriversAndRequests()
    {
        if (_driverService == null || _saveChickenRequestService == null || _isDisposed)
        {
            return;
        }

        var pageSize = 2000;

        var driverSearch = new SaveChickenDriveRequestSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var driverResults = await _driverService.SearchAsync(driverSearch);
        Drivers = driverResults.Data;

        var saveChickenRequestSearch = new SaveChickenRequestSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var saveChickenRequestResults = await _saveChickenRequestService.SearchAsync(saveChickenRequestSearch);
        SaveChickenRequests = saveChickenRequestResults.Data;
    }

    /// <summary>
    /// Selects a driver and defaults the viewed drive to the action's first date.
    /// </summary>
    private void SelectDriver(SaveChickenDriveRequestDto? driver)
    {
        _selectedDriver = driver;
        _selectedDriveDate = GetDefaultDriveDate(driver);
        BuildMapForSelectedDrive();
    }

    /// <summary>
    /// Default date shown when a driver is selected: the first date of the action.
    /// </summary>
    private DateOnly? GetDefaultDriveDate(SaveChickenDriveRequestDto? driver)
    {
        if (driver == null)
            return null;

        return saveChickenActionDto.Dates is { Count: > 0 } ? saveChickenActionDto.Dates[0] : null;
    }

    /// <summary>
    /// Switches which date's drive is being viewed/edited for the currently selected driver.
    /// </summary>
    private void SelectDriveDate(DateOnly date)
    {
        _selectedDriveDate = date;
        BuildMapForSelectedDrive();
        _needsDropRefresh = true;
        StateHasChanged();
    }

    private void BuildRequestItems()
    {
        _requestItems = SaveChickenRequests.Select(r =>
        {
            var hasAssignment = _requestDriverAssignments.TryGetValue(r.Id, out var assignment) && assignment.HasValue;
            return new DropItem
            {
                Name = $"{r.Person?.Contact?.FirstName} {r.Person?.Contact?.LastName}",
                Selector = hasAssignment
                    ? BuildDriveSelector(assignment!.Value.DriverId, assignment.Value.Date)
                    : "unassigned",
                saveChickenRequest = r
            };
        })
        // 1. Put assigned items first (1), and unassigned items last (2)
        .OrderBy(i => i.Selector == "unassigned" ? 2 : 1)
        // 2. Sort assigned items by their saved Order index, and unassigned by Postal Code
        .ThenBy(i => i.Selector == "unassigned"
            ? i.saveChickenRequest.Person?.Address?.PostalCode
            : _requestDriverAssignments.TryGetValue(i.saveChickenRequest.Id, out var assignment) && assignment.HasValue
                ? assignment.Value.Order.ToString("D6") // Format padding to string to keep types compatible
                : "999999")
        .ToList();
    }

    /// <summary>
    /// Total requests assigned to this driver across ALL of their drives (all dates).
    /// </summary>
    private int GetAssignedCount(SaveChickenDriveRequestDto driver)
    {
        return _requestItems.Count(i => TryParseDriveSelector(i.Selector, out var driverId, out _) && driverId == driver.Id);
    }

    /// <summary>
    /// Requests assigned to a specific driver + date drive. Used to annotate the date selector.
    /// </summary>
    private int GetAssignedCountForDrive(int driverId, DateOnly date)
    {
        var selector = BuildDriveSelector(driverId, date);
        return _requestItems.Count(i => i.Selector == selector);
    }

    /// <summary>
    /// Handles drag-and-drop events, including reordering within a zone and moving between zones.
    /// </summary>
    private void RequestItemDropped(MudItemDropInfo<DropItem> dropItem)
    {
        if (dropItem.Item?.saveChickenRequest == null)
            return;

        var item = dropItem.Item;

        // Remove from its current position in the flat list
        _requestItems.Remove(item);

        // Update zone + assignment tracking memory
        item.Selector = dropItem.DropzoneIdentifier;
        if (dropItem.DropzoneIdentifier == "unassigned")
        {
            _requestDriverAssignments[item.saveChickenRequest.Id] = null;
        }
        else if (TryParseDriveSelector(dropItem.DropzoneIdentifier, out var driverId, out var date))
        {
            // Set it to its target index in the zone temporarily so it maintains sequence sanity before saving
            _requestDriverAssignments[item.saveChickenRequest.Id] = (driverId, date, dropItem.IndexInZone);
        }

        // Figure out where in the flat list this corresponds to, based on
        // the other items currently in the same zone
        var itemsInZone = _requestItems.Where(i => i.Selector == dropItem.DropzoneIdentifier).ToList();

        int insertIndex;
        if (dropItem.IndexInZone >= itemsInZone.Count)
        {
            var lastInZone = itemsInZone.LastOrDefault();
            insertIndex = lastInZone == null ? _requestItems.Count : _requestItems.IndexOf(lastInZone) + 1;
        }
        else
        {
            var targetItem = itemsInZone[dropItem.IndexInZone];
            insertIndex = _requestItems.IndexOf(targetItem);
        }

        _requestItems.Insert(insertIndex, item);

        // Crucial fix: Fix the order indices of ALL items inside this modified zone
        // to prevent order overlaps if BuildRequestItems runs again before saving.
        if (dropItem.DropzoneIdentifier != "unassigned" && TryParseDriveSelector(dropItem.DropzoneIdentifier, out var
zoneDriverId, out var zoneDate))
        {
            var updatedZoneItems = _requestItems.Where(i => i.Selector == dropItem.DropzoneIdentifier).ToList();
            for (int i = 0; i < updatedZoneItems.Count; i++)
            {
                _requestDriverAssignments[updatedZoneItems[i].saveChickenRequest.Id] = (zoneDriverId, zoneDate, i);
            }
        }

        _requestItems = new List<DropItem>(_requestItems);
        BuildMapForSelectedDrive();

        _needsDropRefresh = true;
        StateHasChanged();
    }

    private void ResetAssignments()
    {
        if (_isDisposed) return;

        _requestDriverAssignments.Clear();
        _selectedDriver = null;
        _selectedDriveDate = null;
        BuildRequestItems();
        BuildMapForSelectedDrive();

        _needsDropRefresh = true;
        StateHasChanged();
    }

    private async Task SaveAssignments()
    {
        if (_isDisposed || _saveChickenActionService == null)
            return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            // Track the current sequence index per drive (driver + date), not just per driver
            var driveCounters = new Dictionary<string, int>();
            var assignmentsList = new List<RequestAssignmentJson>();

            foreach (var item in _requestItems)
            {
                if (TryParseDriveSelector(item.Selector, out var driverId, out var date))
                {
                    if (!driveCounters.ContainsKey(item.Selector))
                    {
                        driveCounters[item.Selector] = 0;
                    }

                    assignmentsList.Add(new RequestAssignmentJson
                    {
                        RequestId = item.saveChickenRequest.Id,
                        DriverId = driverId,
                        Date = date,
                        Order = driveCounters[item.Selector]++ // Increments order value (0, 1, 2...) per drive
                    });
                }
            }

            var savedData = new SavedRequestAssignmentsData
            {
                Version = 3, // Upgraded version tracking: now includes per-drive Date
                Assignments = assignmentsList
            };

            var json = JsonSerializer.Serialize(savedData);
            saveChickenActionDto.DriverRoutePlansJson = json;
            await _saveChickenActionService.UpdateAsync(saveChickenActionDto);

            Snackbar.Add("Zuordnungen und Reihenfolge erfolgreich gespeichert!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Speichern: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Loads saved request-to-drive assignments, if any exist for this action.
    /// </summary>
    private void LoadSavedAssignments()
    {
        if (string.IsNullOrWhiteSpace(saveChickenActionDto.DriverRoutePlansJson))
            return;

        try
        {
            var savedData = JsonSerializer.Deserialize<SavedRequestAssignmentsData>(saveChickenActionDto.DriverRoutePlansJson);
            if (savedData?.Assignments == null)
                return;

            foreach (var assignment in savedData.Assignments)
            {
                // Store Driver ID, Date and saved sequence rank
                _requestDriverAssignments[assignment.RequestId] = (assignment.DriverId, assignment.Date, assignment.Order);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading saved assignments: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        if (_cancellationTokenSource != null)
        {
            _cancellationTokenSource.Cancel();
            _cancellationTokenSource.Dispose();
            _cancellationTokenSource = null;
        }

        await Task.CompletedTask;
    }

    public class SavedRequestAssignmentsData
    {
        public int Version { get; set; }
        public List<RequestAssignmentJson> Assignments { get; set; } = new();
    }

    public class RequestAssignmentJson
    {
        public int RequestId { get; set; }
        public int DriverId { get; set; }
        public DateOnly Date { get; set; }
        public int Order { get; set; }
    }

    /// <summary>
    /// Total animals for the currently viewed drive (selected driver + selected date), not the driver's other dates.
    /// </summary>
    private int GetTotalSelectedAnimals(SaveChickenDriveRequestDto driver)
    {
        var selector = CurrentDriveSelector;
        if (selector == null) return 0;

        return _requestItems
            .Where(i => i.Selector == selector)
            .Sum(i => i.saveChickenRequest.NumberOfChickensToBeSaved + i.saveChickenRequest.NumberOfRoostersToBeSaved);
    }

    private int GetTotalNumberOfChickens(SaveChickenDriveRequestDto driver)
    {
        var selector = CurrentDriveSelector;
        if (selector == null) return 0;

        return _requestItems
            .Where(i => i.Selector == selector)
            .Sum(i => i.saveChickenRequest.NumberOfChickensToBeSaved);
    }

    private int GetTotalNumberOfRoosters(SaveChickenDriveRequestDto driver)
    {
        var selector = CurrentDriveSelector;
        if (selector == null) return 0;

        return _requestItems
            .Where(i => i.Selector == selector)
            .Sum(i => i.saveChickenRequest.NumberOfRoostersToBeSaved);
    }

    /// <summary>
    /// Builds map markers/arrows for the currently viewed drive (selected driver + selected date),
    /// in the same order they appear in that drive's column.
    /// </summary>
    private void BuildMapForSelectedDrive()
    {
        _selectedDriverMarkers = new List<MapMarker>();
        _selectedDriverArrows = new List<MapArrow>();
        _selectedDriverDistanceKm = 0;

        var selector = CurrentDriveSelector;
        if (selector == null)
            return;

        var assignedRequests = _requestItems
            .Where(i => i.Selector == selector)
            .Select(i => i.saveChickenRequest)
            .Where(r => r.Person?.Address?.GeoCoordinate != null)
            .ToList();

        foreach (var request in assignedRequests)
        {
            _selectedDriverMarkers.Add(new MapMarker
            {
                Latitude = request.Person!.Address!.GeoCoordinate!.Latitude,
                Longitude = request.Person.Address.GeoCoordinate.Longitude,
                Info = $"{request.Person.Contact?.FirstName} {request.Person.Contact?.LastName}, {request.Person.Address.Street}, {request.Person.Address.PostalCode} {request.Person.Address.City}, {request.NumberOfChickensToBeSaved} Hühner, {request.NumberOfRoostersToBeSaved} Hähne"
            });
        }

        for (int i = 0; i < _selectedDriverMarkers.Count - 1; i++)
        {
            var from = _selectedDriverMarkers[i];
            var to = _selectedDriverMarkers[i + 1];

            _selectedDriverArrows.Add(new MapArrow
            {
                LatitudeFrom = from.Latitude,
                LongitudeFrom = from.Longitude,
                LatitudeTo = to.Latitude,
                LongitudeTo = to.Longitude
            });

            _selectedDriverDistanceKm += CalculateDistance(from.Latitude, from.Longitude, to.Latitude, to.Longitude);
        }
    }

    /// <summary>
    /// Calculate distance between two coordinates using Haversine formula
    /// </summary>
    private double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        const double R = 6371; // Earth's radius in km
        var dLat = ToRadians(lat2 - lat1);
        var dLon = ToRadians(lon2 - lon1);

        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(ToRadians(lat1)) * Math.Cos(ToRadians(lat2)) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);

        var c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return R * c;
    }

    private double ToRadians(double degrees)
    {
        return degrees * Math.PI / 180;
    }
}
