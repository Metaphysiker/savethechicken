@using MauiBlazorWeb.Shared.Classes
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Helpers
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject GenericDtoServiceFactory DtoServiceFactory
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 my-4" Elevation="2">
    <MudText Typo="Typo.h3" Class="mb-4">Routen-Planer V3</MudText>

    @* Action buttons *@
    <MudPaper Class="mb-4 pa-3" Elevation="1">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ResetAssignments" Class="mr-2">
            Reset
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAssignments" Disabled="_isSaving" Class="mr-2">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Speichern...</MudText>
            }
            else
            {
                <MudText>Speichern</MudText>
            }
        </MudButton>
    </MudPaper>

    <MudDropContainer T="DropItem" @ref="_dropContainer" Items="_requestItems"
                      ItemsSelector="@((item, dropzone) => item.Selector == dropzone)" ItemDropped="RequestItemDropped">
        <ChildContent>
            <MudGrid>
                @* Column 1: Meeting locations (click to select, not a dropzone) *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-2" Elevation="2" Style="height: 400px; overflow-y: auto;">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                                  Class="mb-2 px-2">
                            <MudText Typo="Typo.h6">Treffpunkte</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small"
                                           OnClick="AddMeetingLocation" title="Neuer Treffpunkt" />
                        </MudStack>

                        @if (_meetingLocations.Count == 0)
                        {
                            <MudText Class="px-2" Typo="Typo.body2" Color="Color.Secondary">
                                Noch keine Treffpunkte. Klicke auf "+" um einen zu erstellen.
                            </MudText>
                        }

                        <MudList T="MeetingLocation" SelectedValue="_selectedLocation"
                                 SelectedValueChanged="SelectLocation">
                            @foreach (var location in _meetingLocations.OrderBy(l => l.DateTime))
                            {
                                <MudListItem T="MeetingLocation" Value="@location">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText>@location.Name</MudText>
                                            <MudText Typo="Typo.caption">
                                                @location.DateTime.ToString("dd.MM.yyyy HH:mm") &middot;
                                                @GetAssignedCountForLocation(location) Angebote
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @(location.DriverIds.Count == 0
                                                    ? "Kein Fahrer zugeordnet"
                                                    : string.Join(", ", location.DriverIds.Select(GetDriverName)))
                                            </MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       Size="Size.Small" OnClick="@(() => RemoveMeetingLocation(location))"
                                                       title="Treffpunkt löschen" />
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>

                @* Column 2: Selected meeting location details + drop zone *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-2" Elevation="2" Style="height: 400px; overflow-y: auto;">
                        @if (_selectedLocation == null)
                        {
                            <MudText Typo="Typo.h6" Class="mb-2 px-2">Treffpunkt</MudText>
                            <MudText Class="px-2" Typo="Typo.body2" Color="Color.Secondary">
                                Wähle einen Treffpunkt aus oder erstelle einen neuen.
                            </MudText>
                        }
                        else
                        {
                            <MudTextField T="string" Label="Name" Value="_selectedLocation.Name"
                                          ValueChanged="OnLocationNameChanged" Margin="Margin.Dense" Class="px-2 mb-2" />

                            <MudStack Row="true" Class="px-2 mb-2">
                                <MudDatePicker Label="Datum" Date="_selectedLocation.DateTime"
                                               DateChanged="OnLocationDateChanged" Margin="Margin.Dense" Dense="true" />
                                <MudTimePicker Label="Zeit" Time="_selectedLocation.DateTime.TimeOfDay"
                                               TimeChanged="OnLocationTimeChanged" Margin="Margin.Dense" Dense="true" />
                            </MudStack>

                            <MudSelect T="int" Label="Fahrer" MultiSelection="true"
                                       SelectedValues="_selectedLocation.DriverIds"
                                       SelectedValuesChanged="OnLocationDriversChanged" ToStringFunc="@GetDriverName" Dense="true"
                                       Margin="Margin.Dense" Class="px-2 mb-2">
                                @foreach (var driver in Drivers)
                                {
                                    <MudSelectItem T="int" Value="@driver.Id">@GetDriverName(driver.Id)</MudSelectItem>
                                }
                            </MudSelect>

                            <MudStack Row="true" Class="px-2 mb-2" AlignItems="AlignItems.Center">
                                <MudNumericField T="double?" Label="Breitengrad"
                                                 Value="_selectedLocation.GeoCoordinate?.Latitude"
                                                 ValueChanged="OnLocationLatitudeChanged" Margin="Margin.Dense" Dense="true" Format="F6"
                                                 Style="max-width: 140px;" />
                                <MudNumericField T="double?" Label="Längengrad"
                                                 Value="_selectedLocation.GeoCoordinate?.Longitude"
                                                 ValueChanged="OnLocationLongitudeChanged" Margin="Margin.Dense" Dense="true" Format="F6"
                                                 Style="max-width: 140px;" />
                                <MapPickerLauncher Coordinate="_selectedLocation.GeoCoordinate"
                                                   CoordinateChanged="OnLocationGeoCoordinateChanged" />
                            </MudStack>

                            <MudDropZone T="DropItem" Identifier="@_selectedLocation.Id" Class="pa-2" AllowReorder="true"
                                         Style="min-height: 100px;" />
                        }
                    </MudPaper>
                </MudItem>

                @* Column 3: Unassigned *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-2" Elevation="2" Style="height: 400px; overflow-y: auto;">
                        <MudText Typo="Typo.h6" Class="mb-2 px-2">Nicht zugeordnet</MudText>
                        <MudDropZone T="DropItem" Identifier="unassigned" Class="pa-2" AllowReorder="true"
                                     Style="min-height: 100px;" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </ChildContent>

        <ItemRenderer>
            <DropItemCardForSaveChickenRequest Item="context" />
        </ItemRenderer>
    </MudDropContainer>
    @if (_selectedLocation != null && GetFirstAssignedDriver(_selectedLocation) != null)
    {
        <MudPaper Class="mt-4 pa-2" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2 px-2">Kartenübersicht</MudText>
            <OpenStreetMap Markers="_overviewMarkers" Arrows="_overviewArrows" />
        </MudPaper>
    }
</MudPaper>

@code {
    private List<MapMarker> _overviewMarkers = new();
    private List<MapArrow> _overviewArrows = new();
    private bool _isLoading = false;
    private bool _isSaving = false;
    private int _lastLoadedActionId = 0;
    private bool _isDisposed = false;
    private CancellationTokenSource? _cancellationTokenSource;

    [Parameter, EditorRequired]
    public SaveChickenActionDto saveChickenActionDto { get; set; } = default!;

    public List<SaveChickenDriveRequestDto> Drivers { get; set; } = new();
    public List<SaveChickenRequestDto> SaveChickenRequests { get; set; } = new();

    private GenericDtoService<SaveChickenActionDto, SaveChickenActionSearch>? _saveChickenActionService;
    private GenericDtoService<SaveChickenRequestDto, SaveChickenRequestSearch>? _saveChickenRequestService;
    private GenericDtoService<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>? _driverService;

    private MudDropContainer<DropItem>? _dropContainer;
    private List<DropItem> _requestItems = new();
    private List<MeetingLocation> _meetingLocations = new();
    private MeetingLocation? _selectedLocation;

    // Key: RequestId. Value: (MeetingLocationId, Order) identifying which meeting location the request is assigned to.
    private Dictionary<int, (string LocationId, int Order)?> _requestLocationAssignments = new();
    private bool _needsDropRefresh = false;
    private List<MapMarker> _selectedDriverMarkers = new();
    private List<MapArrow> _selectedDriverArrows = new();
    private double _selectedDriverDistanceKm;

    protected override void OnInitialized()
    {
        _saveChickenActionService = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();
        _driverService = DtoServiceFactory.Create<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>();
        _saveChickenRequestService = DtoServiceFactory.Create<SaveChickenRequestDto, SaveChickenRequestSearch>();
        _cancellationTokenSource = new CancellationTokenSource();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isDisposed) return;
        if (_isLoading) return;

        var currentActionId = saveChickenActionDto?.Id ?? 0;
        var isNewAction = _lastLoadedActionId != currentActionId;

        _isLoading = true;
        try
        {
            await LoadData();
            _lastLoadedActionId = currentActionId;

            if (isNewAction)
            {
                Snackbar.Add("Route-Planer geladen", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Laden: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_needsDropRefresh && _dropContainer != null)
        {
            _needsDropRefresh = false;
            _dropContainer.Refresh();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Helper to rebuild all map layers whenever coordinates, paths, or assignments change.
    /// </summary>
    private void RefreshMaps()
    {
        Console.WriteLine("Refreshing maps...");
        BuildMapForSelectedLocation();
        BuildOverviewMap();
    }

    private async Task LoadData()
    {
        if (_isDisposed) return;

        Drivers.Clear();
        SaveChickenRequests.Clear();
        _requestItems = new List<DropItem>();
        _meetingLocations = new List<MeetingLocation>();
        _requestLocationAssignments.Clear();
        _selectedLocation = null;

        await GetAndSetDriversAndRequests();
        LoadSavedAssignments();
        BuildRequestItems();

        RefreshMaps(); // Rebuild both maps with initial loaded coordinates
        _needsDropRefresh = true;
    }

    private async Task GetAndSetDriversAndRequests()
    {
        if (_driverService == null || _saveChickenRequestService == null || _isDisposed)
        {
            return;
        }

        var pageSize = 2000;

        var driverSearch = new SaveChickenDriveRequestSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var driverResults = await _driverService.SearchAsync(driverSearch);
        Drivers = driverResults.Data;

        var saveChickenRequestSearch = new SaveChickenRequestSearch
        {
            SaveChickenActionIds = new List<int> { saveChickenActionDto.Id },
            PageSize = pageSize
        };
        var saveChickenRequestResults = await _saveChickenRequestService.SearchAsync(saveChickenRequestSearch);
        SaveChickenRequests = saveChickenRequestResults.Data;
    }

    private void SelectLocation(MeetingLocation? location)
    {
        _selectedLocation = location;
        RefreshMaps();
        _needsDropRefresh = true;
    }

    private void AddMeetingLocation()
    {
        var defaultDate = saveChickenActionDto.Dates is { Count: > 0 }
            ? saveChickenActionDto.Dates[0].ToDateTime(TimeOnly.MinValue)
            : DateTime.Today;

        var newLocation = new MeetingLocation
        {
            Name = $"Treffpunkt {_meetingLocations.Count + 1}",
            DateTime = defaultDate
        };

        _meetingLocations.Add(newLocation);
        SelectLocation(newLocation);
    }

    private void RemoveMeetingLocation(MeetingLocation location)
    {
        foreach (var item in _requestItems.Where(i => i.Selector == location.Id))
        {
            item.Selector = "unassigned";
            _requestLocationAssignments[item.saveChickenRequest.Id] = null;
        }

        _meetingLocations.Remove(location);

        if (_selectedLocation == location)
        {
            _selectedLocation = null;
        }

        _requestItems = new List<DropItem>(_requestItems);
        RefreshMaps();
        _needsDropRefresh = true;
        StateHasChanged();
    }

    private void OnLocationNameChanged(string name)
    {
        if (_selectedLocation == null) return;
        _selectedLocation.Name = name;
        _needsDropRefresh = true;
        StateHasChanged();
    }

    private void OnLocationDateChanged(DateTime? date)
    {
        if (_selectedLocation == null || date == null) return;
        _selectedLocation.DateTime = date.Value.Date + _selectedLocation.DateTime.TimeOfDay;
        RefreshMaps();
        StateHasChanged();
    }

    private void OnLocationTimeChanged(TimeSpan? time)
    {
        if (_selectedLocation == null || time == null) return;
        _selectedLocation.DateTime = _selectedLocation.DateTime.Date + time.Value;
        RefreshMaps();
        StateHasChanged();
    }

    private void OnLocationDriversChanged(IEnumerable<int> driverIds)
    {
        if (_selectedLocation == null) return;
        _selectedLocation.DriverIds = driverIds?.ToList() ?? new List<int>();
        RefreshMaps();
        StateHasChanged();
    }

    private string GetDriverName(int driverId)
    {
        var driver = Drivers.FirstOrDefault(d => d.Id == driverId);
        return driver == null ? "?" : $"{driver.Person?.Contact?.FirstName} {driver.Person?.Contact?.LastName}";
    }

    private SaveChickenDriveRequestDto? GetFirstAssignedDriver(MeetingLocation location)
    {
        if (location.DriverIds.Count == 0) return null;
        return Drivers.FirstOrDefault(d => d.Id == location.DriverIds[0]);
    }

    private void BuildRequestItems()
    {
        _requestItems = SaveChickenRequests.Select(r =>
        {
            var hasAssignment = _requestLocationAssignments.TryGetValue(r.Id, out var assignment) && assignment.HasValue;
            return new DropItem
            {
                Name = $"{r.Person?.Contact?.FirstName} {r.Person?.Contact?.LastName}",
                Selector = hasAssignment ? assignment!.Value.LocationId : "unassigned",
                saveChickenRequest = r
            };
        })
        .OrderBy(i => i.Selector == "unassigned" ? 2 : 1)
        .ThenBy(i => i.Selector == "unassigned"
            ? i.saveChickenRequest.Person?.Address?.PostalCode
            : _requestLocationAssignments.TryGetValue(i.saveChickenRequest.Id, out var assignment) && assignment.HasValue
                ? assignment.Value.Order.ToString("D6")
                : "999999")
        .ToList();
    }

    private int GetAssignedCountForLocation(MeetingLocation location)
    {
        return _requestItems.Count(i => i.Selector == location.Id);
    }

    private void RequestItemDropped(MudItemDropInfo<DropItem> dropItem)
    {
        if (dropItem.Item?.saveChickenRequest == null)
            return;

        var item = dropItem.Item;
        _requestItems.Remove(item);

        item.Selector = dropItem.DropzoneIdentifier;
        if (dropItem.DropzoneIdentifier == "unassigned")
        {
            _requestLocationAssignments[item.saveChickenRequest.Id] = null;
        }
        else
        {
            _requestLocationAssignments[item.saveChickenRequest.Id] = (dropItem.DropzoneIdentifier, dropItem.IndexInZone);
        }

        var itemsInZone = _requestItems.Where(i => i.Selector == dropItem.DropzoneIdentifier).ToList();

        int insertIndex;
        if (dropItem.IndexInZone >= itemsInZone.Count)
        {
            var lastInZone = itemsInZone.LastOrDefault();
            insertIndex = lastInZone == null ? _requestItems.Count : _requestItems.IndexOf(lastInZone) + 1;
        }
        else
        {
            var targetItem = itemsInZone[dropItem.IndexInZone];
            insertIndex = _requestItems.IndexOf(targetItem);
        }

        _requestItems.Insert(insertIndex, item);

        if (dropItem.DropzoneIdentifier != "unassigned")
        {
            var updatedZoneItems = _requestItems.Where(i => i.Selector == dropItem.DropzoneIdentifier).ToList();
            for (int i = 0; i < updatedZoneItems.Count; i++)
            {
                _requestLocationAssignments[updatedZoneItems[i].saveChickenRequest.Id] = (dropItem.DropzoneIdentifier, i);
            }
        }

        _requestItems = new List<DropItem>(_requestItems);
        RefreshMaps();

        _needsDropRefresh = true;
        StateHasChanged();
    }

    private void ResetAssignments()
    {
        if (_isDisposed) return;

        _requestLocationAssignments.Clear();
        _meetingLocations.Clear();
        _selectedLocation = null;
        BuildRequestItems();
        RefreshMaps();

        _needsDropRefresh = true;
        StateHasChanged();
    }

    private async Task SaveAssignments()
    {
        if (_isDisposed || _saveChickenActionService == null)
            return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            var locationCounters = new Dictionary<string, int>();
            var assignmentsList = new List<RequestAssignmentJson>();

            foreach (var item in _requestItems)
            {
                if (item.Selector != "unassigned" && _meetingLocations.Any(l => l.Id == item.Selector))
                {
                    if (!locationCounters.ContainsKey(item.Selector))
                    {
                        locationCounters[item.Selector] = 0;
                    }

                    assignmentsList.Add(new RequestAssignmentJson
                    {
                        RequestId = item.saveChickenRequest.Id,
                        MeetingLocationId = item.Selector,
                        Order = locationCounters[item.Selector]++
                    });
                }
            }

            var savedData = new SavedRequestAssignmentsData
            {
                Version = 4,
                MeetingLocations = _meetingLocations,
                Assignments = assignmentsList
            };

            var json = JsonSerializer.Serialize(savedData);
            saveChickenActionDto.DriverRoutePlansJson = json;
            await _saveChickenActionService.UpdateAsync(saveChickenActionDto);

            Snackbar.Add("Zuordnungen und Reihenfolge erfolgreich gespeichert!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Speichern: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void LoadSavedAssignments()
    {
        if (string.IsNullOrWhiteSpace(saveChickenActionDto.DriverRoutePlansJson))
            return;

        try
        {
            var savedData = JsonSerializer.Deserialize<SavedRequestAssignmentsData>(saveChickenActionDto.DriverRoutePlansJson);
            if (savedData == null)
                return;

            if (savedData.Version < 4)
            {
                Console.WriteLine($"Route plan data is version {savedData.Version}, predates the Meeting Location model (v4). Starting fresh.");
                return;
            }

            _meetingLocations = savedData.MeetingLocations ?? new List<MeetingLocation>();

            if (savedData.Assignments == null)
                return;

            foreach (var assignment in savedData.Assignments)
            {
                _requestLocationAssignments[assignment.RequestId] = (assignment.MeetingLocationId, assignment.Order);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading saved assignments: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        if (_cancellationTokenSource != null)
        {
            _cancellationTokenSource.Cancel();
            _cancellationTokenSource.Dispose();
            _cancellationTokenSource = null;
        }

        await Task.CompletedTask;
    }

    public class MeetingLocation
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Name { get; set; } = "";
        public DateTime DateTime { get; set; } = DateTime.Today;
        public List<int> DriverIds { get; set; } = new();
        public GeoCoordinate? GeoCoordinate { get; set; }
    }

    public class SavedRequestAssignmentsData
    {
        public int Version { get; set; }
        public List<MeetingLocation> MeetingLocations { get; set; } = new();
        public List<RequestAssignmentJson> Assignments { get; set; } = new();
    }

    public class RequestAssignmentJson
    {
        public int RequestId { get; set; }
        public string MeetingLocationId { get; set; } = "";
        public int Order { get; set; }
    }

    private int GetTotalNumberOfChickens(MeetingLocation location)
    {
        return _requestItems
            .Where(i => i.Selector == location.Id)
            .Sum(i => i.saveChickenRequest.NumberOfChickensToBeSaved);
    }

    private int GetTotalNumberOfRoosters(MeetingLocation location)
    {
        return _requestItems
            .Where(i => i.Selector == location.Id)
            .Sum(i => i.saveChickenRequest.NumberOfRoostersToBeSaved);
    }

    private void BuildMapForSelectedLocation()
    {
        _selectedDriverMarkers = new List<MapMarker>();
        _selectedDriverArrows = new List<MapArrow>();
        _selectedDriverDistanceKm = 0;

        if (_selectedLocation == null)
            return;

        var assignedRequests = _requestItems
            .Where(i => i.Selector == _selectedLocation.Id)
            .Select(i => i.saveChickenRequest)
            .Where(r => r.Person?.Address?.GeoCoordinate != null)
            .ToList();

        foreach (var request in assignedRequests)
        {
            _selectedDriverMarkers.Add(new MapMarker
            {
                Latitude = request.Person!.Address!.GeoCoordinate!.Latitude,
                Longitude = request.Person.Address.GeoCoordinate.Longitude,
                Info = $"{request.Person.Contact?.FirstName} {request.Person.Contact?.LastName}, {request.Person.Address.Street}, {request.Person.Address.PostalCode} {request.Person.Address.City}, {request.NumberOfChickensToBeSaved} Hühner, {request.NumberOfRoostersToBeSaved} Hähne"
            });
        }

        for (int i = 0; i < _selectedDriverMarkers.Count - 1; i++)
        {
            var from = _selectedDriverMarkers[i];
            var to = _selectedDriverMarkers[i + 1];

            _selectedDriverArrows.Add(new MapArrow
            {
                LatitudeFrom = from.Latitude,
                LongitudeFrom = from.Longitude,
                LatitudeTo = to.Latitude,
                LongitudeTo = to.Longitude
            });

            _selectedDriverDistanceKm += CalculateDistance(from.Latitude, from.Longitude, to.Latitude, to.Longitude);
        }
    }

    private double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        const double R = 6371;
        var dLat = ToRadians(lat2 - lat1);
        var dLon = ToRadians(lon2 - lon1);

        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(ToRadians(lat1)) * Math.Cos(ToRadians(lat2)) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);

        var c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return R * c;
    }

    private double ToRadians(double degrees)
    {
        return degrees * Math.PI / 180;
    }

    private void OnLocationLatitudeChanged(double? latitude)
    {
        if (_selectedLocation == null) return;
        _selectedLocation.GeoCoordinate ??= new GeoCoordinate();
        _selectedLocation.GeoCoordinate.Latitude = latitude ?? 0;
        RefreshMaps();
        StateHasChanged();
    }

    private void OnLocationLongitudeChanged(double? longitude)
    {
        if (_selectedLocation == null) return;
        _selectedLocation.GeoCoordinate ??= new GeoCoordinate();
        _selectedLocation.GeoCoordinate.Longitude = longitude ?? 0;
        RefreshMaps();
        StateHasChanged();
    }

    private void OnLocationCoordinateChanged(GeoCoordinate? coordinate)
    {
        if (_selectedLocation == null) return;
        _selectedLocation.GeoCoordinate = coordinate;
        RefreshMaps();
        StateHasChanged();
    }

    private void OnLocationGeoCoordinateChanged(GeoCoordinate? coordinate)
    {
        if (_selectedLocation == null) return;
        _selectedLocation.GeoCoordinate = coordinate;
        RefreshMaps();
        StateHasChanged();
    }

    private void BuildOverviewMap()
    {
        _overviewMarkers = new List<MapMarker>();
        _overviewArrows = new List<MapArrow>();

        foreach (var location in _meetingLocations)
        {
            if (location.GeoCoordinate == null)
                continue;

            _overviewMarkers.Add(new MapMarker
            {
                Latitude = location.GeoCoordinate.Latitude,
                Longitude = location.GeoCoordinate.Longitude,
                Color = "orange",
                Info = $"{location.Name} ({location.DateTime:dd.MM.yyyy HH:mm})"
            });

            foreach (var driverId in location.DriverIds)
            {
                var driverCoordinate = Drivers.FirstOrDefault(d => d.Id == driverId)?.Person?.Address?.GeoCoordinate;
                if (driverCoordinate == null)
                    continue;

                _overviewArrows.Add(new MapArrow
                {
                    LatitudeFrom = driverCoordinate.Latitude,
                    LongitudeFrom = driverCoordinate.Longitude,
                    LatitudeTo = location.GeoCoordinate.Latitude,
                    LongitudeTo = location.GeoCoordinate.Longitude
                });
            }
        }

        foreach (var driver in Drivers)
        {
            var driverCoordinate = driver.Person?.Address?.GeoCoordinate;
            if (driverCoordinate == null)
                continue;

            _overviewMarkers.Add(new MapMarker
            {
                Latitude = driverCoordinate.Latitude,
                Longitude = driverCoordinate.Longitude,
                Info = $"{GetDriverName(driver.Id)} (Fahrer)"
            });
        }
    }
}
