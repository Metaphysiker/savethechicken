                            @L["Address_Street"]
                            @if (GetSortIcon("Farm.Address.Street") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Address.Street")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Address?.Street</CellTemplate>
                </TemplateColumn>
            }

            <!-- Address City -->
            @if (IsColumnVisible("Address.City"))
