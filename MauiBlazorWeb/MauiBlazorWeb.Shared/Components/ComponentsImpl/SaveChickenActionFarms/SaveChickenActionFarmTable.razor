                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Address?.City</CellTemplate>
                </TemplateColumn>
            }

            <!-- Address Postal Code -->
            @if (IsColumnVisible("Address.PostalCode"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.Address.PostalCode"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["Address_PostalCode"]
                            @if (GetSortIcon("Farm.Address.PostalCode") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Address.PostalCode")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Address?.PostalCode</CellTemplate>
                </TemplateColumn>
