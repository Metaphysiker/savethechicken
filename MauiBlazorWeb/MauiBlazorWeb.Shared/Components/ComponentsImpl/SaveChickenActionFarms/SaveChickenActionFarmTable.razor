                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.NumberOfRoostersToBeSaved</CellTemplate>
                </TemplateColumn>
            }

            <!-- Farm Size -->
            @if (IsColumnVisible("Size"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.Size"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["Farm_Size"]
                            @if (GetSortIcon("Farm.Size") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Size")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Size</CellTemplate>
                </TemplateColumn>
            }

            <!-- Farm Color -->
            @if (IsColumnVisible("Color"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.Color"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["Color"]
                            @if (GetSortIcon("Farm.Color") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Color")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Color</CellTemplate>
                </TemplateColumn>
            }

            <!-- General Information -->
            @if (IsColumnVisible("GeneralInformation"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.GeneralInformation"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["GeneralInformation"]
                            @if (GetSortIcon("Farm.GeneralInformation") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.GeneralInformation")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.GeneralInformation</CellTemplate>
                </TemplateColumn>
            }

            <!-- Stored Files -->
            @if (IsColumnVisible("Files"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        @L["Files"]
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.Farm?.Files != null)
                        {
                            @foreach (var file in context.Item.Farm.Files)
                            {
                                <StoredFileDialog StoredFile="file" />
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            <!-- Show Action -->
            @if (IsColumnVisible("Show"))
            {
                <TemplateColumn>
                    <HeaderTemplate>@L["show"]</HeaderTemplate>
                    <CellTemplate>
                        <MudButton Variant="Variant.Filled" OnClick="@(() => ShowItem(context.Item.Id))"
                                   UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "view-button" })">
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            }

            <!-- Edit Action -->
            @if (IsColumnVisible("Edit"))
            {
                <TemplateColumn>
                    <HeaderTemplate>@L["edit"]</HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item != null)
                        {
                            <GenericUpdateDialogLauncher TDto="SaveChickenActionFarmDto" model="context.Item"
                                                         OnEdited="@(() => OnItemsChanged.InvokeAsync())">
                                <ChildContent Context="editModel">
                                    <SaveChickenActionFarmForm Model="editModel" IsSaveChickenActionReadOnly="true" />
                                </ChildContent>
                            </GenericUpdateDialogLauncher>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            <!-- Delete Action -->
            @if (IsColumnVisible("Delete"))
            {
                <TemplateColumn>
                    <HeaderTemplate>@L["delete"]</HeaderTemplate>
                    <CellTemplate>
                        <GenericDeleteDialog TDto="SaveChickenActionFarmDto" Model="context.Item"
                                             OnDeleted="@(() => OnItemsChanged.InvokeAsync())" />
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>
    </MudDataGrid>
</div>