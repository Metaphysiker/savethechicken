@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Farms
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.StoredFiles
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using MudBlazor
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppResources> L

@code {
    [Parameter]
    public List<SaveChickenActionFarmDto> items { get; set; } = new List<SaveChickenActionFarmDto>();

    /// <summary>
    /// List of column names to hide (e.g., ["Farm", "Show", "Edit", "Delete"]).
    /// Case-insensitive evaluation.
    /// </summary>
    [Parameter]
    public IEnumerable<string> HiddenColumns { get; set; } = Enumerable.Empty<string>();

    [Parameter] public EventCallback<SaveChickenActionFarmDto> OnItemSelected { get; set; }
    void SelectItem(SaveChickenActionFarmDto item) => OnItemSelected.InvokeAsync(item);

    [Parameter] public EventCallback<(string? SortBy, bool? SortDescending)> OnSortSelected { get; set; }
    void SortByColumn(string columnName, bool? descending) => OnSortSelected.InvokeAsync((columnName, descending));

    [Parameter] public EventCallback OnItemsChanged { get; set; }

    private string? currentColumnName = null;
    private bool? currentSortDescending = null;

    private bool IsColumnVisible(string columnName)
    {
        return !HiddenColumns.Any(c => string.Equals(c, columnName, StringComparison.OrdinalIgnoreCase));
    }

    private void OnHeaderClick(string columnName)
    {
        bool? descending = currentColumnName == columnName ? !currentSortDescending : false;
        currentColumnName = columnName;
        currentSortDescending = descending;
        SortByColumn(columnName, descending);
    }

    private string? GetSortIcon(string columnName)
    {
        if (currentColumnName != columnName) return null;
        return currentSortDescending == true ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;
    }

    private void ShowItem(int id)
    {
        NavigationManager.NavigateTo($"/admin/save-chicken-action-farms/{id}");
    }
}

<div style="overflow-x: auto; max-width: 100%;">
    <MudDataGrid Items="@items" Hover="true" Dense="true" Striped="true" Bordered="true" SortMode="SortMode.None">
        <Columns>
            <!-- SaveChickenAction Column -->
            @if (IsColumnVisible("SaveChickenAction"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("SaveChickenAction.Title"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["SaveChickenAction"]
                            @if (GetSortIcon("SaveChickenAction.Title") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("SaveChickenAction.Title")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>
                        @(context.Item.SaveChickenAction?.Title ?? context.Item.SaveChickenActionId.ToString())
                    </CellTemplate>
                </TemplateColumn>
            }

            <!-- Farm Name Column -->
            @if (IsColumnVisible("Farm"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.Name"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["Farm_Name"]
                            @if (GetSortIcon("Farm.Name") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Name")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.Farm?.Name))
                        {
                            @context.Item.Farm.Name
                        }
                        else if (context.Item.Farm != null)
                        {
                            <span style="color: orange; font-style: italic;">(Unnamed Farm - ID: @context.Item.FarmId)</span>
                        }
                        else
                        {
                            <span style="color: red; font-style: italic;">N/A (Farm: ✗ - ID: @context.Item.FarmId)</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }

            <!-- Contact First Name -->
            @if (IsColumnVisible("Contact.FirstName"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.Contact.FirstName"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["Contact_FirstName"]
                            @if (GetSortIcon("Farm.Contact.FirstName") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Contact.FirstName")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Contact?.FirstName</CellTemplate>
                </TemplateColumn>
            }

            <!-- Contact Last Name -->
            @if (IsColumnVisible("Contact.LastName"))
            {
                <TemplateColumn>
                    <HeaderTemplate>
                        <MudButton OnClick="@(() => OnHeaderClick("Farm.Contact.LastName"))" Variant="Variant.Text"
                                   Style="text-transform: none;">
                            @L["Contact_LastName"]
                            @if (GetSortIcon("Farm.Contact.LastName") != null)
                            {
                                <MudIcon Icon="@GetSortIcon("Farm.Contact.LastName")" Size="Size.Small" />
                            }
                        </MudButton>
                    </HeaderTemplate>
                    <CellTemplate>@context.Item.Farm?.Contact?.LastName</CellTemplate>
                </TemplateColumn>
            }

            <!-- Address Street -->
            @if (IsColumnVisible("Address.Street"))
