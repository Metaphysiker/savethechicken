@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Farms
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using MudBlazor
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppResources> L

@code {
    [Parameter]
    public List<SaveChickenActionFarmDto> items { get; set; } = new List<SaveChickenActionFarmDto>();

    [Parameter] public EventCallback<SaveChickenActionFarmDto> OnItemSelected { get; set; }
    void SelectItem(SaveChickenActionFarmDto item) => OnItemSelected.InvokeAsync(item);

    [Parameter] public EventCallback<(string? SortBy, bool? SortDescending)> OnSortSelected { get; set; }
    void SortByColumn(string columnName, bool? descending) => OnSortSelected.InvokeAsync((columnName, descending));

    [Parameter] public EventCallback OnItemsChanged { get; set; }

    private string? currentColumnName = null;
    private bool? currentSortDescending = null;

    private void OnHeaderClick(string columnName)
    {
        bool? descending = currentColumnName == columnName ? !currentSortDescending : false;
        currentColumnName = columnName;
        currentSortDescending = descending;
        SortByColumn(columnName, descending);
    }

    private string? GetSortIcon(string columnName)
    {
        if (currentColumnName != columnName) return null;
        return currentSortDescending == true ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;
    }

    private void ShowItem(int id)
    {
        NavigationManager.NavigateTo($"/admin/save-chicken-action-farms/{id}");
    }
}

<div style="overflow-x: auto; max-width: 100%;">
    <MudDataGrid Items="@items" Hover="true" Dense="true" Striped="true" Bordered="true" SortMode="SortMode.None">
        <Columns>
            <!-- SaveChickenAction Column -->
            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("SaveChickenAction.Title"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["SaveChickenAction"]
                        @if (GetSortIcon("SaveChickenAction.Title") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("SaveChickenAction.Title")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>
                    @(context.Item.SaveChickenAction?.Title ?? context.Item.SaveChickenActionId.ToString())
                </CellTemplate>
            </TemplateColumn>

            <!-- Farm Column -->
            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("Farm.Name"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["Farm"]
                        @if (GetSortIcon("Farm.Name") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("Farm.Name")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>
                    @(context.Item.Farm?.Name ?? context.Item.FarmId.ToString())
                </CellTemplate>
            </TemplateColumn>

            <!-- Number of Chickens to be Saved -->
            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("NumberOfChickensToBeSaved"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["NumberOfChickensToBeSaved"]
                        @if (GetSortIcon("NumberOfChickensToBeSaved") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("NumberOfChickensToBeSaved")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>@context.Item.NumberOfChickensToBeSaved</CellTemplate>
            </TemplateColumn>

            <!-- Number of Roosters to be Saved -->
            <TemplateColumn>
                <HeaderTemplate>
                    <MudButton OnClick="@(() => OnHeaderClick("NumberOfRoostersToBeSaved"))" Variant="Variant.Text" Style="text-transform: none;">
                        @L["NumberOfRoostersToBeSaved"]
                        @if (GetSortIcon("NumberOfRoostersToBeSaved") != null)
                        {
                            <MudIcon Icon="@GetSortIcon("NumberOfRoostersToBeSaved")" Size="Size.Small" />
                        }
                    </MudButton>
                </HeaderTemplate>
                <CellTemplate>@context.Item.NumberOfRoostersToBeSaved</CellTemplate>
            </TemplateColumn>

            <!-- Show Action -->
            <TemplateColumn>
                <HeaderTemplate>@L["show"]</HeaderTemplate>
                <CellTemplate>
                    <MudButton Variant="Variant.Filled"
                               OnClick="@(() => ShowItem(context.Item.Id))"
                               UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "view-button" })">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>

            <!-- Edit Action -->
            <TemplateColumn>
                <HeaderTemplate>@L["edit"]</HeaderTemplate>
                <CellTemplate>
                    @if (context.Item != null)
                    {
                        <GenericUpdateDialog TDto="SaveChickenActionFarmDto"
                                             Model="context.Item"
                                             OnEdited="@(() => OnItemsChanged.InvokeAsync())">
                            <ChildContent Context="editModel">
                                <SaveChickenActionFarmForm Model="editModel" />
                            </ChildContent>
                        </GenericUpdateDialog>
                    }
                </CellTemplate>
            </TemplateColumn>

            <!-- Delete Action -->
            <TemplateColumn>
                <HeaderTemplate>@L["delete"]</HeaderTemplate>
                <CellTemplate>
                    <GenericDeleteDialog TDto="SaveChickenActionFarmDto"
                                         Model="context.Item"
                                         OnDeleted="@(() => OnItemsChanged.InvokeAsync())" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</div>
