@using MauiBlazorWeb.Shared.Classes
@using global::Shared.Dtos.DtosImpl
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="mapDiv" style="height: 500px;"></div>

@code {
    [Parameter, EditorRequired]
    public List<MapMarker> Markers { get; set; } = default!;

    [Parameter]
    public List<MapArrow> Arrows { get; set; } = new();

    // The single, click-selected coordinate. Two-way bindable: @bind-SelectedCoordinate
    [Parameter]
    public GeoCoordinate? SelectedCoordinate { get; set; }

    [Parameter]
    public EventCallback<GeoCoordinate?> SelectedCoordinateChanged { get; set; }

    private ElementReference mapDiv;
    private bool _mapInitialized;
    private DotNetObjectReference<OpenStreetMapPicker>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initMap", mapDiv, Markers);
            await JS.InvokeVoidAsync("enableClickSelection", mapDiv, _selfRef);

            if (SelectedCoordinate is not null)
                await JS.InvokeVoidAsync("setSelectedMarker", mapDiv, SelectedCoordinate);

            _mapInitialized = true;
        }

        if (!_mapInitialized)
            return;

        await UpdateMapAsync();
    }

    private async Task UpdateMapAsync()
    {
        await JS.InvokeVoidAsync("updateMarkers", mapDiv, Markers);

        await JS.InvokeVoidAsync("clearArrows", mapDiv);
        foreach (var arrow in Arrows)
        {
            await JS.InvokeVoidAsync(
                "drawArrow",
                mapDiv,
                new { latitude = arrow.LatitudeFrom, longitude = arrow.LongitudeFrom },
                new { latitude = arrow.LatitudeTo, longitude = arrow.LongitudeTo }
            );
        }
    }

    // Called from JS when the map is clicked. JS is responsible for
    // replacing the previous selection marker with the new one.
    [JSInvokable]
    public async Task OnMapClicked(double latitude, double longitude)
    {
        SelectedCoordinate = new GeoCoordinate { Latitude = latitude, Longitude = longitude };
        await SelectedCoordinateChanged.InvokeAsync(SelectedCoordinate);
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
