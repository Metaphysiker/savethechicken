@typeparam TDto where TDto : class, IDto

@using MudBlazor
@using global::Shared.Dtos
@inject IDialogService DialogService


@if (model != null && ChildContent != null)
{
    <MudButton Variant="Variant.Filled" OnClick="OpenDialog" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Edit"
               UserAttributes="@(new Dictionary<string, object> { ["data-testid"] = "edit-button" })">
        @if (!string.IsNullOrWhiteSpace(ButtonText))
        {
            @ButtonText
        }
    </MudButton>
}

@code {
    private IDialogReference? _dialogReference;
    [Parameter, EditorRequired] public TDto model { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TDto> ChildContent { get; set; } = default!;
    [Parameter]
    public EventCallback OnEdited { get; set; }

    [Parameter]
    public string? ButtonText { get; set; }


    private async Task OpenDialog()
    {
        if (model == null || ChildContent == null)
            return;
        var parameters = new DialogParameters
        {
            { "Model", model },
            { "ChildContent", ChildContent },
            { "OnEdited", EventCallback.Factory.Create(this, HandleEdited) }
        };
        var options = new DialogOptions { FullScreen = true, CloseButton = true, MaxWidth = MaxWidth.False };
        _dialogReference = await DialogService.ShowAsync<GenericUpdateDialog<TDto>>("Bearbeitung", parameters, options);
    }

    private async Task HandleEdited()
    {
        _dialogReference?.Close();
        await OnEdited.InvokeAsync();
    }
}
