@using MauiBlazorWeb.Shared.Classes
@page "/route-planner"
    <MudPaper Class="pa-4 my-4" Elevation="2">
        <MudText Typo="Typo.h3">Routen-Planer</MudText>


    <OpenStreetMap markers="@(new List<MapMarker> { from, to })" arrows="@(new List<MapArrow> { arrow })" />

    </MudPaper>
@code {
    MapMarker from = new MapMarker { Latitude = 52.5200, Longitude = 13.4050, Info = "Berlin" };
    MapMarker to = new MapMarker { Latitude = 48.1351, Longitude = 11.5820, Info = "München" };
    MapArrow arrow = new MapArrow
    {
        LatitudeFrom = 52.5200,
        LongitudeFrom = 13.4050,
        LatitudeTo = 48.1351,
        LongitudeTo = 11.5820,
    };
}
