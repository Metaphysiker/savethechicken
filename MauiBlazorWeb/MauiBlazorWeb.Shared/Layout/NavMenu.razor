@using MauiBlazorWeb.Shared.Singletons.SingletonsImpl
@inject AuthResponseSingleton authResponseSingleton
@inject NavigationManager navigationManager
@inject AuthService authService

<MudNavMenu>
    <MudNavLink Href="/" Class="nav-link-entry" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudDivider Class="my-2" />

    @if (authService.isLoading == true)
    {
        <MudNavLink Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Downloading">Bitte warten ...</MudNavLink>

    } else
    {
        @if (!authResponseSingleton.IsLoggedIn)
        {
            <MudNavLink Href="/platz-anbieten" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Support">Platz für Hühner anbieten</MudNavLink>
            <MudNavLink Href="/fahrer-werden" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DirectionsCar">Fahrer werden</MudNavLink>
            <MudNavLink Href="/betrieb-anmelden" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Agriculture">Betrieb anmelden</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/login" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
        }
        else
        {
            <MudNavLink Href="/admin/persons" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Personen verwalten</MudNavLink>
            <MudNavLink Href="/admin/persons/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">Neue Person</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/save-chicken-actions" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Rettungs-Aktionen</MudNavLink>
            <MudNavLink Href="/admin/save-chicken-actions/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Neue Rettungs-Aktion</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/save-chicken-requests" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Support">Platzangebote</MudNavLink>
            <MudNavLink Href="/admin/save-chicken-requests/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Neues Platzangebot</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/save-chicken-drive-requests" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DirectionsCar">Fahrangebote</MudNavLink>
            <MudNavLink Href="/admin/save-chicken-drive-requests/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Neues Fahrangebot</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/farms" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Agriculture">Betriebe</MudNavLink>
            <MudNavLink Href="/admin/farms/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Neuer Betrieb</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/workflow" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NextPlan">Workflow</MudNavLink>
            <MudDivider Class="my-2" />
            <MudButton Class="nav-link-entry ml-4" StartIcon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Variant="Variant.Text" Style="justify-content: flex-start; width: 100%;" OnClick="logout">
                Logout
            </MudButton>
        }
    }

    <MudDivider Class="my-2" />
    @if (_drawerOpen)
    {
        <MudNavLink OnClick="@HandleCloseDrawer" Icon="@Icons.Material.Filled.ArrowLeft">Schliessen</MudNavLink>
    } else {
        <MudNavLink OnClick="@HandleOpenDrawer" Icon="@Icons.Material.Filled.ArrowRight">Öffnen</MudNavLink>
    }
</MudNavMenu>

<style>
    .nav-link-entry {
        white-space: nowrap;
        overflow: hidden;
    }
</style>

@code {
    [Parameter] public bool _drawerOpen { get; set; }
    [Parameter] public EventCallback OnCloseDrawer { get; set; }
    [Parameter] public EventCallback OnOpenDrawer { get; set; }

    private async Task HandleCloseDrawer()
    {
        await OnCloseDrawer.InvokeAsync();
    }

    private async Task HandleOpenDrawer()
    {
        await OnOpenDrawer.InvokeAsync();
    }

    private async Task logout()
    {
        await authService.LogoutAsync();
        navigationManager.NavigateTo("/");
    }
}
