@using MauiBlazorWeb.Shared.Singletons.SingletonsImpl
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@inject AuthResponseSingleton authResponseSingleton
@inject NavigationManager navigationManager
@inject AuthService authService
@inject GenericDtoServiceFactory DtoServiceFactory
@inject IStringLocalizer<AppResources> L
@implements IDisposable

<MudNavMenu>
    <MudNavLink Href="@HomeUrl" Class="nav-link-entry" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudDivider Class="my-2" />

    @if (authService.isLoading == true)
    {
        <MudNavLink Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Downloading">@L["PleaseWait"]</MudNavLink>

    } else
    {
        @if (!authResponseSingleton.IsLoggedIn)
        {
            <MudNavLink Href="/platz-anbieten" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Support">@L["OfferPlace"]</MudNavLink>
            <MudNavLink Href="/fahrer-werden" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DirectionsCar">@L["BecomeDriver"]</MudNavLink>
            <MudNavLink Href="/betrieb-anmelden" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Agriculture">@L["RegisterFarm"]</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/login" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">@L["Login"]</MudNavLink>
        }
        else
        {
            <MudNavLink Href="/admin/persons" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">@L["ManagePersons"]</MudNavLink>
            <MudNavLink Href="/admin/persons/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">@L["NewPerson"]</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/save-chicken-actions" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">@L["RescueActions"]</MudNavLink>
            <MudNavLink Href="/admin/save-chicken-actions/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">@L["NewRescueAction"]</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/save-chicken-requests" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Support">@L["SaveChickenRequests"]</MudNavLink>
            <MudNavLink Href="/admin/save-chicken-requests/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">@L["NewPlaceOffer"]</MudNavLink>
            <MudNavLink Href="/admin/incoming-save-chicken-requests" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inbox">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                    <span>@L["IncomingSaveChickenRequests"]</span>
                    @if (pendingRequestsCount > 0)
                    {
                        <MudBadge Content="@pendingRequestsCount" Color="Color.Error" Overlap="true" Style="margin-right: 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" />
                        </MudBadge>
                    }
                </MudStack>
            </MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/save-chicken-drive-requests" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DirectionsCar">@L["SaveChickenDriveRequests"]</MudNavLink>
            <MudNavLink Href="/admin/save-chicken-drive-requests/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">@L["NewDriveOffer"]</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/farms" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Agriculture">@L["Farms"]</MudNavLink>
            <MudNavLink Href="/admin/farms/new" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">@L["NewFarm"]</MudNavLink>
            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/geolocation-update" Class="nav-link-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocationOn">@L["GeolocationUpdate"]</MudNavLink>
            <MudDivider Class="my-2" />

            <MudButton Class="nav-link-entry ml-4" StartIcon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Variant="Variant.Text" Style="justify-content: flex-start; width: 100%;" OnClick="logout">
                @L["Logout"]
            </MudButton>
        }
    }

    <MudDivider Class="my-2" />
    @if (_drawerOpen)
    {
        <MudNavLink OnClick="@HandleCloseDrawer" Icon="@Icons.Material.Filled.ArrowLeft">@L["Close"]</MudNavLink>
    } else {
        <MudNavLink OnClick="@HandleOpenDrawer" Icon="@Icons.Material.Filled.ArrowRight">@L["Open"]</MudNavLink>
    }
</MudNavMenu>

<style>
    .nav-link-entry {
        white-space: nowrap;
        overflow: hidden;
    }
</style>

@code {
    [Parameter] public bool _drawerOpen { get; set; }
    [Parameter] public EventCallback OnCloseDrawer { get; set; }
    [Parameter] public EventCallback OnOpenDrawer { get; set; }

    private int pendingRequestsCount = 0;
    private System.Threading.Timer? _timer;

    private string HomeUrl => authResponseSingleton.IsAdmin
        ? "/admin/persons"
        : "/";

    protected override void OnInitialized()
    {
        authResponseSingleton.OnChange += OnAuthStateChanged;

        // Load initial count
        _ = LoadPendingRequestsCount();

        // Set up timer to refresh count every 30 seconds
        _timer = new System.Threading.Timer(async _ => await LoadPendingRequestsCount(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnAuthStateChanged()
    {
        // Reload count when auth state changes
        _ = LoadPendingRequestsCount();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        authResponseSingleton.OnChange -= OnAuthStateChanged;
        _timer?.Dispose();
    }

    private async Task HandleCloseDrawer()
    {
        await OnCloseDrawer.InvokeAsync();
    }

    private async Task HandleOpenDrawer()
    {
        await OnOpenDrawer.InvokeAsync();
    }

    private async Task logout()
    {
        await authService.LogoutAsync();
        navigationManager.NavigateTo("/");
    }

    private async Task LoadPendingRequestsCount()
    {
        // Only load if user is logged in as admin
        if (!authResponseSingleton.IsLoggedIn || !authResponseSingleton.IsAdmin)
        {
            pendingRequestsCount = 0;
            return;
        }

        try
        {
            var service = DtoServiceFactory.Create<SaveChickenRequestDto, SaveChickenRequestSearch>();
            var searchParams = new SaveChickenRequestSearch
            {
                IsHandled = false,
                IsSubmittedFromPublicForm = true,
                PageSize = 1, // We only need the count
                Page = 1
            };

            var result = await service.SearchAsync(searchParams);
            pendingRequestsCount = result.TotalItems;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Silently fail - don't show errors in nav menu
            Console.WriteLine($"Error loading pending requests count: {ex.Message}");
            pendingRequestsCount = 0;
        }
    }
}
