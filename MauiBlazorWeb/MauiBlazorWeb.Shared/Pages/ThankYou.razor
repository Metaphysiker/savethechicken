@page "/thank-you"
@layout MauiBlazorWeb.Shared.Layouts.MinimalLayout

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Class="pa-8" Elevation="3">
        <div style="text-align: center;">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Style="font-size: 5rem;" />

            <MudText Typo="Typo.h3" Class="mt-4 mb-2">
                Vielen Dank!
            </MudText>

            <MudText Typo="Typo.h5" Class="mb-4" Color="Color.Primary">
                Ihre Anfrage wurde erfolgreich übermittelt
            </MudText>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body1" Class="mb-4">
                Wir haben Ihre Anfrage erhalten und werden uns in Kürze bei Ihnen melden.
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Sie sollten eine Bestätigungs-E-Mail erhalten haben. Bitte überprüfen Sie auch Ihren Spam-Ordner.
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Warning" Class="mt-4">
                Sie werden in @countdown Sekunden weitergeleitet.
            </MudText>

        </div>
    </MudPaper>
</MudContainer>

@code {
    private int countdown = 10;
    private System.Threading.Timer? timer;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override void OnInitialized()
    {
        timer = new System.Threading.Timer(_ =>
        {
            if (countdown > 0)
            {
                countdown--;
                InvokeAsync(StateHasChanged);
            }
            if (countdown == 0)
            {
                timer?.Dispose();
                InvokeAsync(() => NavigationManager.NavigateTo("https://www.rettetdashuhn.ch/", true));
            }
        }, null, 1000, 1000);
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}

