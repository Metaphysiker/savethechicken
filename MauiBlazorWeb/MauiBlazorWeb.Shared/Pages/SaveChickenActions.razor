@page "/admin/save-chicken-actions/{id:int}"

@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenDriveRequests
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Farms
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenRequests
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Forms
@inject GenericDtoServiceFactory DtoServiceFactory
@inject SaveChickenActionService saveChickenActionService
@inject IStringLocalizer<AppResources> L
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <h3>@L["SaveChickenAction"]</h3>

    @if(selectedAction != null)
    {
        <MudPaper Class="pa-4 my-4" data-testid="action-details">
            <MudText Typo="Typo.h5" Class="mb-2" data-testid="action-title">@selectedAction.Title</MudText>

            @if (!string.IsNullOrWhiteSpace(selectedAction.Description))
            {
                <MudText Typo="Typo.body1" Class="mb-3" data-testid="action-description">@selectedAction.Description</MudText>
            }

            @if (selectedAction.Dates != null && selectedAction.Dates.Any())
            {
                <MudText Typo="Typo.body2" Class="mt-3">
                    <strong>@L["TransferDates"]</strong>
                </MudText>
                <div data-testid="action-transfer-dates">
                    @foreach (var date in selectedAction.Dates.OrderBy(d => d))
                    {
                        <MudChip T="string" Size="Size.Small" Class="mr-1">@date.ToString("dd.MM.yyyy")</MudChip>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <MudButton Variant="Variant.Filled"
                      Color="Color.Success"
                      OnClick="OpenRoutePlannerDialog"
                      StartIcon="@Icons.Material.Filled.Route"
                      Size="Size.Large"
                      FullWidth="true"
                      data-testid="open-route-planner-button">
                <MudText Typo="Typo.h6">Routen-Planer öffnen</MudText>
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">@L["Adopters"]</MudText>

            <GenericSearch @key="@searchRefreshKey" TDto="SaveChickenRequestDto" TSearchDto="SaveChickenRequestSearch" search="saveChickenRequestSearch" OnItemsFound="OnItemsFound">
                <SearchForm Context="search">
                    <SaveChickenRequestSearchForm Model="search" />
                </SearchForm>
                <Table Context="ctx">
                    <SaveChickenRequestTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
                </Table>
            </GenericSearch>

            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      OnClick="OpenAddSaveChickenRequestDialog"
                      StartIcon="@Icons.Material.Filled.Add"
                      Class="mt-3"
                      data-testid="add-save-chicken-request-button">
                @L["AddSaveChickenRequest"]
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <SaveChickenRequestMap saveChickenRequestDtos="foundSaveChickenRequests" />
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <MudText Typo="Typo.h6">@L["Drivers"]</MudText>

            <GenericSearch @key="@driveRequestRefreshKey" TDto="SaveChickenDriveRequestDto" TSearchDto="SaveChickenDriveRequestSearch" search="saveChickenDriveRequestSearch" OnItemsFound="OnSaveChickenDriveRequestItemsFound">
                <SearchForm Context="search">
                    <SaveChickenDriveRequestSearchForm Model="search" />
                </SearchForm>
                <Table Context="ctx">
                    <SaveChickenDriveRequestTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
                </Table>
            </GenericSearch>

            <MudButton Variant="Variant.Filled"
                      Color="Color.Secondary"
                      OnClick="OpenAddSaveChickenDriveRequestDialog"
                      StartIcon="@Icons.Material.Filled.Add"
                      Class="mt-3"
                      data-testid="add-drive-request-button">
                @L["AddDriveRequest"]
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <MudText Typo="Typo.h6">@L["Farms"]</MudText>

            <GenericSearch @key="@farmRefreshKey" TDto="FarmDto" TSearchDto="FarmSearch" search="farmSearch" OnItemsFound="OnFarmItemsFound">
                <SearchForm Context="search">
                    <FarmSearchForm Model="search" />
                </SearchForm>
                <Table Context="ctx">
                    <FarmTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
                </Table>
            </GenericSearch>

            <MudButton Variant="Variant.Filled"
                      Color="Color.Tertiary"
                      OnClick="OpenAddFarmDialog"
                      StartIcon="@Icons.Material.Filled.Add"
                      Class="mt-3"
                      data-testid="add-farm-button">
                @L["AddFarm"]
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <FarmMap farmDtos="foundFarms" />
        </MudPaper>

        <MudDivider Class="my-4"></MudDivider>

        @if (selectedAction != null)
        {
            <MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions.SaveChickenActionStatistic saveChickenActionDto="selectedAction" />
        }
    }
</MudContainer>


@code {
    private SaveChickenActionDto? selectedAction;
    private int? selectedActionId;
    private SaveChickenRequestSearch saveChickenRequestSearch = new SaveChickenRequestSearch();
    private SaveChickenDriveRequestSearch saveChickenDriveRequestSearch = new SaveChickenDriveRequestSearch();
    private FarmSearch farmSearch = new FarmSearch();
    private List<SaveChickenRequestDto> foundSaveChickenRequests = new();
    private List<FarmDto> foundFarms = new();
    private List<SaveChickenDriveRequestDto> saveChickenDriveRequests = new();
    private int searchRefreshKey = 0;
    private int driveRequestRefreshKey = 0;
    private int farmRefreshKey = 0;

    [Parameter]
    public int? id { get; set; }

    private void OnItemsFound(List<SaveChickenRequestDto> foundItems)
    {
        foundSaveChickenRequests = foundItems;
        StateHasChanged();
    }

    private void OnFarmItemsFound(List<FarmDto> farms)
    {
        foundFarms = farms;
        StateHasChanged();
    }

    private void OnSaveChickenDriveRequestItemsFound(List<SaveChickenDriveRequestDto> driveRequests)
    {
        saveChickenDriveRequests = driveRequests;
        StateHasChanged();
    }

    private void OnActionSelected(SaveChickenActionDto action)
    {
        selectedAction = action;
        UpdateSearches();
        StateHasChanged();
    }

    private void UpdateSearches()
    {
        UpdateSaveChickenRequestSearch();
        UpdateSaveChickenDriveRequestSearch();
        UpdateFarmSearch();
    }

    protected override async Task OnInitializedAsync()
    {

        if (id.HasValue)
        {
            // Load the SaveChickenAction by ID
            var service = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();
            selectedAction = await service.GetByIdAsync(id.Value);

            if (selectedAction != null)
            {
                selectedActionId = selectedAction.Id;
                UpdateSearches();
            }
        }
        else
        {
            var activeSaveChickenAction = await saveChickenActionService.GetActiveSaveChickenAction();
            if (activeSaveChickenAction != null)
            {
                selectedAction = activeSaveChickenAction;
                selectedActionId = activeSaveChickenAction.Id;
                UpdateSearches();
            }
        }


    }

    private void UpdateSaveChickenRequestSearch()
    {
       var saveChickenActionIds = selectedAction != null
        ? new List<int> { selectedAction.Id }
        : new List<int>();

            saveChickenRequestSearch = new SaveChickenRequestSearch
            {
                SaveChickenActionIds = saveChickenActionIds
            };
    }

    private void UpdateFarmSearch()
    {
        var saveChickenActionIds = selectedAction != null
         ? new List<int> { selectedAction.Id }
         : new List<int>();
        farmSearch = new FarmSearch
        {
            SaveChickenActionIds = saveChickenActionIds
        };
    }

    private void UpdateSaveChickenDriveRequestSearch()
    {
        var saveChickenActionIds = selectedAction != null
         ? new List<int> { selectedAction.Id }
         : new List<int>();
        saveChickenDriveRequestSearch = new SaveChickenDriveRequestSearch
        {
            SaveChickenActionIds = saveChickenActionIds
        };
    }

    private async Task OpenAddSaveChickenRequestDialog()
    {
        if (selectedAction == null || selectedAction.Id == 0)
            return;

        // Create a new SaveChickenRequestDto with the action preselected
        var newRequest = new SaveChickenRequestDto
        {
            SaveChickenActionId = selectedAction.Id,
            Files = new List<StoredFileDto>()
        };

        var modelWithFiles = new ItemWithBrowserFiles<SaveChickenRequestDto>
        {
            Item = newRequest,
            Files = new List<IBrowserFile>()
        };

        // Create the render fragment with PreSelectedSaveChickenActionId parameter
        RenderFragment<ItemWithBrowserFiles<SaveChickenRequestDto>> childContent = (editModel) => builder =>
        {
            builder.OpenComponent<SaveChickenRequestFormWithFiles>(0);
            builder.AddAttribute(1, "EntityWithFiles", editModel);
            builder.AddAttribute(2, "PreSelectedSaveChickenActionId", selectedAction.Id);
            builder.CloseComponent();
        };

        var parameters = new DialogParameters
        {
            { "Model", modelWithFiles },
            { "ChildContent", childContent },
            { "OnCreated", EventCallback.Factory.Create(this, HandleRequestCreated) }
        };

        var options = new DialogOptions { FullScreen = true, CloseButton = true, MaxWidth = MaxWidth.False };
        await DialogService.ShowAsync<GenericCreateWithFilesDialog<SaveChickenRequestDto>>(L["CreateSaveChickenRequest"], parameters, options);
    }

    private void HandleRequestCreated()
    {
        // Force GenericSearch to refresh by changing the key
        searchRefreshKey++;
        StateHasChanged();
    }

    private async Task OpenAddSaveChickenDriveRequestDialog()
    {
        if (selectedAction == null || selectedAction.Id == 0)
            return;

        // Create a new SaveChickenDriveRequestDto with the action preselected
        var newRequest = new SaveChickenDriveRequestDto
        {
            SaveChickenActionId = selectedAction.Id,
            Files = new List<StoredFileDto>()
        };

        var modelWithFiles = new ItemWithBrowserFiles<SaveChickenDriveRequestDto>
        {
            Item = newRequest,
            Files = new List<IBrowserFile>()
        };

        // Create the render fragment with PreSelectedSaveChickenActionId parameter
        RenderFragment<ItemWithBrowserFiles<SaveChickenDriveRequestDto>> childContent = (editModel) => builder =>
        {
            builder.OpenComponent<SaveChickenDriveRequestFormWithFiles>(0);
            builder.AddAttribute(1, "EntityWithFiles", editModel);
            builder.AddAttribute(2, "PreSelectedSaveChickenActionId", selectedAction.Id);
            builder.CloseComponent();
        };

        var parameters = new DialogParameters
        {
            { "Model", modelWithFiles },
            { "ChildContent", childContent },
            { "OnCreated", EventCallback.Factory.Create(this, HandleDriveRequestCreated) }
        };

        var options = new DialogOptions { FullScreen = true, CloseButton = true, MaxWidth = MaxWidth.False };
        await DialogService.ShowAsync<GenericCreateWithFilesDialog<SaveChickenDriveRequestDto>>(L["CreateDriveRequest"], parameters, options);
    }

    private void HandleDriveRequestCreated()
    {
        // Force GenericSearch to refresh by changing the key
        driveRequestRefreshKey++;
        StateHasChanged();
    }

    private async Task OpenAddFarmDialog()
    {
        if (selectedAction == null || selectedAction.Id == 0)
            return;

        // Create a new FarmDto with the action preselected
        var newFarm = new FarmDto
        {
            SaveChickenActionId = selectedAction.Id,
            Files = new List<StoredFileDto>()
        };

        var modelWithFiles = new ItemWithBrowserFiles<FarmDto>
        {
            Item = newFarm,
            Files = new List<IBrowserFile>()
        };

        // Create the render fragment with PreSelectedSaveChickenActionId parameter
        RenderFragment<ItemWithBrowserFiles<FarmDto>> childContent = (editModel) => builder =>
        {
            builder.OpenComponent<FarmFormWithFiles>(0);
            builder.AddAttribute(1, "EntityWithFiles", editModel);
            builder.AddAttribute(2, "PreSelectedSaveChickenActionId", selectedAction.Id);
            builder.CloseComponent();
        };

        var parameters = new DialogParameters
        {
            { "Model", modelWithFiles },
            { "ChildContent", childContent },
            { "OnCreated", EventCallback.Factory.Create(this, HandleFarmCreated) }
        };

        var options = new DialogOptions { FullScreen = true, CloseButton = true, MaxWidth = MaxWidth.False };
        await DialogService.ShowAsync<GenericCreateWithFilesDialog<FarmDto>>(L["CreateFarm"], parameters, options);
    }

    private void HandleFarmCreated()
    {
        // Force GenericSearch to refresh by changing the key
        farmRefreshKey++;
        StateHasChanged();
    }

    private async Task OpenRoutePlannerDialog()
    {
        if (selectedAction == null)
            return;

        var parameters = new DialogParameters
        {
            { "SaveChickenActionDto", selectedAction }
        };

        var options = new DialogOptions
        {
            FullScreen = true,
            CloseButton = true,
            MaxWidth = MaxWidth.False,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions.SaveChickenActionRoutePlannerDialog>(
            "Routen-Planer",
            parameters,
            options);
    }
}
