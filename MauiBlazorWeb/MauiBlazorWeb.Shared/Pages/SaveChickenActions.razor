@page "/admin/save-chicken-actions/{id:int}"

@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenDriveRequests
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Farms
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenRequests
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@inject GenericDtoServiceFactory DtoServiceFactory
@inject SaveChickenActionService saveChickenActionService

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <h3>Rettungs-Aktionen</h3>

    @if(selectedAction != null)
    {
        <MudPaper Class="pa-4 my-4" data-testid="action-details">
            <MudText Typo="Typo.h5" Class="mb-2" data-testid="action-title">@selectedAction.Title</MudText>

            @if (!string.IsNullOrWhiteSpace(selectedAction.Description))
            {
                <MudText Typo="Typo.body1" Class="mb-3" data-testid="action-description">@selectedAction.Description</MudText>
            }

            @if (selectedAction.Dates != null && selectedAction.Dates.Any())
            {
                <MudText Typo="Typo.body2" Class="mt-3">
                    <strong>Übergabedaten:</strong>
                </MudText>
                <div data-testid="action-transfer-dates">
                    @foreach (var date in selectedAction.Dates.OrderBy(d => d))
                    {
                        <MudChip T="string" Size="Size.Small" Class="mr-1">@date.ToString("dd.MM.yyyy")</MudChip>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Abnehmer</MudText>

            <GenericSearch TDto="SaveChickenRequestDto" TSearchDto="SaveChickenRequestSearch" search="saveChickenRequestSearch" OnItemsFound="OnItemsFound">
                <SearchForm Context="search">
                    <SaveChickenRequestSearchForm Model="search" />
                </SearchForm>
                <Table Context="ctx">
                    <SaveChickenRequestTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
                </Table>
            </GenericSearch>
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <SaveChickenRequestMap saveChickenRequestDtos="foundSaveChickenRequests" />
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <MudText Typo="Typo.h6">Fahrer</MudText>

            <GenericSearch TDto="SaveChickenDriveRequestDto" TSearchDto="SaveChickenDriveRequestSearch" search="saveChickenDriveRequestSearch" OnItemsFound="OnSaveChickenDriveRequestItemsFound">
                <SearchForm Context="search">
                    <SaveChickenDriveRequestSearchForm Model="search" />
                </SearchForm>
                <Table Context="ctx">
                    <SaveChickenDriveRequestTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
                </Table>
            </GenericSearch>
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <MudText Typo="Typo.h6">Betriebe</MudText>

            <GenericSearch TDto="FarmDto" TSearchDto="FarmSearch" search="farmSearch" OnItemsFound="OnFarmItemsFound">
                <SearchForm Context="search">
                    <FarmSearchForm Model="search" />
                </SearchForm>
                <Table Context="ctx">
                    <FarmTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
                </Table>
            </GenericSearch>
        </MudPaper>

        <MudPaper Class="pa-4 my-4">
            <FarmMap farmDtos="foundFarms" />
        </MudPaper>

        <MudDivider Class="my-4"></MudDivider>

        @if (selectedAction != null)
        {
            <MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions.SaveChickenActionStatistic saveChickenActionDto="selectedAction" />
        }

        @if (selectedAction != null)
        {
            <MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions.SaveChickenActionRoutePlanner saveChickenActionDto="selectedAction" />
        }
    }
</MudContainer>


@code {
    private SaveChickenActionDto? selectedAction;
    private int? selectedActionId;
    private SaveChickenRequestSearch saveChickenRequestSearch = new SaveChickenRequestSearch();
    private SaveChickenDriveRequestSearch saveChickenDriveRequestSearch = new SaveChickenDriveRequestSearch();
    private FarmSearch farmSearch = new FarmSearch();
    private List<SaveChickenRequestDto> foundSaveChickenRequests = new();
    private List<FarmDto> foundFarms = new();
    private List<SaveChickenDriveRequestDto> saveChickenDriveRequests = new();

    [Parameter]
    public int? id { get; set; }

    private void OnItemsFound(List<SaveChickenRequestDto> foundItems)
    {
        foundSaveChickenRequests = foundItems;
        StateHasChanged();
    }

    private void OnFarmItemsFound(List<FarmDto> farms)
    {
        foundFarms = farms;
        StateHasChanged();
    }

    private void OnSaveChickenDriveRequestItemsFound(List<SaveChickenDriveRequestDto> driveRequests)
    {
        saveChickenDriveRequests = driveRequests;
        StateHasChanged();
    }

    private void OnActionSelected(SaveChickenActionDto action)
    {
        selectedAction = action;
        UpdateSearches();
        StateHasChanged();
    }

    private void UpdateSearches()
    {
        UpdateSaveChickenRequestSearch();
        UpdateSaveChickenDriveRequestSearch();
        UpdateFarmSearch();
    }

    protected override async Task OnInitializedAsync()
    {

        if (id.HasValue)
        {
            // Load the SaveChickenAction by ID
            var service = DtoServiceFactory.Create<SaveChickenActionDto, SaveChickenActionSearch>();
            selectedAction = await service.GetByIdAsync(id.Value);

            if (selectedAction != null)
            {
                selectedActionId = selectedAction.Id;
                UpdateSearches();
            }
        }
        else
        {
            var activeSaveChickenAction = await saveChickenActionService.GetActiveSaveChickenAction();
            if (activeSaveChickenAction != null)
            {
                selectedAction = activeSaveChickenAction;
                selectedActionId = activeSaveChickenAction.Id;
                UpdateSearches();
            }
        }


    }

    private void UpdateSaveChickenRequestSearch()
    {
       var saveChickenActionIds = selectedAction != null
        ? new List<int> { selectedAction.Id }
        : new List<int>();

            saveChickenRequestSearch = new SaveChickenRequestSearch
            {
                SaveChickenActionIds = saveChickenActionIds
            };
    }

    private void UpdateFarmSearch()
    {
        var saveChickenActionIds = selectedAction != null
         ? new List<int> { selectedAction.Id }
         : new List<int>();
        farmSearch = new FarmSearch
        {
            SaveChickenActionIds = saveChickenActionIds
        };
    }

    private void UpdateSaveChickenDriveRequestSearch()
    {
        var saveChickenActionIds = selectedAction != null
         ? new List<int> { selectedAction.Id }
         : new List<int>();
        saveChickenDriveRequestSearch = new SaveChickenDriveRequestSearch
        {
            SaveChickenActionIds = saveChickenActionIds
        };
    }
}
