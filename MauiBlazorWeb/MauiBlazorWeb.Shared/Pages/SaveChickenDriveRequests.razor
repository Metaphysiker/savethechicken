@page "/admin/save-chicken-drive-requests/{id:int}"

@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenDriveRequests
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.Persons
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@inject GenericDtoServiceFactory DtoServiceFactory

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <h3>Fahrangebot Details</h3>

    @if (item != null)
    {
        <!-- Use CompactPersonDetailsCard to display person info -->
        @if (item.PersonId.HasValue)
        {
            <CompactPersonDetailsCard PersonId="item.PersonId.Value" />
        }

        <MudPaper Class="pa-4 my-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Fahrangebot Information</MudText>

            @if (!string.IsNullOrWhiteSpace(item.CarMake))
            {
                <MudText Typo="Typo.body1" Class="mt-2" data-testid="drive-request-car">
                    <strong>Auto:</strong> @item.CarMake
                </MudText>
            }

            @if (item.CapacityForChickens > 0)
            {
                <MudText Typo="Typo.body1" Class="mt-2" data-testid="drive-request-capacity">
                    <strong>Kapazität:</strong> @item.CapacityForChickens
                </MudText>
            }

            @if (item.AvailableDates != null && item.AvailableDates.Any())
            {
                <MudText Typo="Typo.body2" Class="mt-3">
                    <strong>Verfügbare Daten:</strong>
                </MudText>
                <div>
                    @foreach (var date in item.AvailableDates.OrderBy(d => d))
                    {
                        <MudChip T="string" Size="Size.Small" Class="mr-1">@date.ToString("dd.MM.yyyy")</MudChip>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(item.Message))
            {
                <MudText Typo="Typo.body1" Class="mt-2" data-testid="drive-request-message-display">
                    <strong>Nachricht:</strong> @item.Message
                </MudText>
            }
        </MudPaper>

        <MudPaper Class="pa-4 my-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Actions</MudText>
            <MudStack Direction="Row" Spacing="2">
                <GenericUpdateDialogLauncher TDto="SaveChickenDriveRequestDto"
                                             model="item"
                                             OnEdited="RefreshItem">
                    <ChildContent Context="editModel">
                        <SaveChickenDriveRequestFormWithFiles EntityWithFiles="@(new ItemWithBrowserFiles<SaveChickenDriveRequestDto> { Item = editModel })" />
                    </ChildContent>
                </GenericUpdateDialogLauncher>
                <GenericDeleteDialog TDto="SaveChickenDriveRequestDto" Model="item" />
            </MudStack>
        </MudPaper>
    }
    else if (Id.HasValue)
    {
        <MudPaper Class="pa-4">
            <MudText>Laden...</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4">
            <MudText>Kein Fahrangebot ausgewählt.</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public int? Id { get; set; }

    private SaveChickenDriveRequestDto? item;

    protected override async Task OnParametersSetAsync()
    {
        await LoadItem();
    }

    private async Task LoadItem()
    {
        if (Id.HasValue)
        {
            var service = DtoServiceFactory.Create<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>();
            item = await service.GetByIdAsync(Id.Value);
            StateHasChanged();
        }
    }

    private async Task RefreshItem()
    {
        await LoadItem();
    }
}
