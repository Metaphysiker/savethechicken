@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenDriveRequests
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Singletons.SingletonsImpl
@inject AuthResponseSingleton AuthResponseSingleton

@page "/fahrer-werden"
@page "/become-driver"
@layout MauiBlazorWeb.Shared.Layouts.MinimalLayout

<PageTitle>Fahrer werden</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class=mt-3>
            <MudText Typo="Typo.h3" Class="mb-4">Ich biete mich als Fahrer:in an</MudText>

        <MudAlert Severity="Severity.Success" Dense="false" Class="my-4">
            <MudText Typo="Typo.body1">
                <strong>Vielen Dank, dass Sie uns als Fahrer unterstützen möchten!</strong>
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                Bitte füllen Sie das untenstehende Formular aus. Wir werden uns in Kürze bei Ihnen melden.
            </MudText>
        </MudAlert>

        @if (AuthResponseSingleton.IsLoggedIn)
        {
            <MudAlert Severity="Severity.Warning" Dense="false" Class="my-4">
                <strong>Achtung!</strong> Dies ist ein öffentliches Formular. Nach dem Absenden wird eine Bestätigungs-E-Mail an die eingegebene E-Mail-Adresse gesendet.
            </MudAlert>
        }

        @if (publicDto != null)
        {
            <PublicSaveChickenDriveRequestForm Model="publicDto" OnSubmitSuccess="HandleSuccess" />
        }

</MudContainer>

@code {
    private SaveChickenDriveRequestPublicDto? publicDto;

    protected override void OnInitialized()
    {
        publicDto = new SaveChickenDriveRequestPublicDto();
    }

    private void HandleSuccess()
    {
        NavigationManager.NavigateTo("/thank-you");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
