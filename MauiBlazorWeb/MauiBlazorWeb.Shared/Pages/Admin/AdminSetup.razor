@page "/admin/setup"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Admin - Database Setup</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h3" Class="mb-4">Database Setup & Seeding</MudText>

        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-4">
            <strong>Warning:</strong> These actions will modify the database. Use with caution!
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h5" Class="mb-2">Setup Identity</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        Creates roles and admin users for authentication.
                    </MudText>
                    <MudButton 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        OnClick="CallSetupEndpoint"
                        Disabled="@_isSetupLoading"
                        FullWidth="true"
                        data-testid="setup-identity-button">
                        @if (_isSetupLoading)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>Setting up...</span>
                        }
                        else
                        {
                            <span>Setup Identity</span>
                        }
                    </MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h5" Class="mb-2">Seed Test Data</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        Creates test data including SaveChickenAction, farms, and requests.
                    </MudText>
                    <MudButton 
                        Variant="Variant.Filled" 
                        Color="Color.Secondary" 
                        OnClick="CallSeedEndpoint"
                        Disabled="@_isSeedLoading"
                        FullWidth="true"
                        data-testid="seed-data-button">
                        @if (_isSeedLoading)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>Seeding...</span>
                        }
                        else
                        {
                            <span>Seed Test Data</span>
                        }
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_lastResult))
        {
            <MudAlert Severity="@_lastResultSeverity" Class="mt-4" Dense="true">
                @_lastResult
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isSetupLoading = false;
    private bool _isSeedLoading = false;
    private string _lastResult = string.Empty;
    private Severity _lastResultSeverity = Severity.Success;

    private async Task CallSetupEndpoint()
    {
        _isSetupLoading = true;
        _lastResult = string.Empty;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync("api/setup/setup");

            if (response.IsSuccessStatusCode)
            {
                _lastResult = "✓ Identity setup completed successfully!";
                _lastResultSeverity = Severity.Success;
                Snackbar.Add("Identity setup completed!", Severity.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                _lastResult = $"✗ Setup failed: {response.StatusCode} - {errorContent}";
                _lastResultSeverity = Severity.Error;
                Snackbar.Add("Setup failed!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _lastResult = $"✗ Exception: {ex.Message}";
            _lastResultSeverity = Severity.Error;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSetupLoading = false;
            StateHasChanged();
        }
    }

    private async Task CallSeedEndpoint()
    {
        _isSeedLoading = true;
        _lastResult = string.Empty;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync("api/setup/seed");

            if (response.IsSuccessStatusCode)
            {
                _lastResult = "✓ Test data seeded successfully!";
                _lastResultSeverity = Severity.Success;
                Snackbar.Add("Test data seeded!", Severity.Success);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                _lastResult = $"✗ Seeding failed: {response.StatusCode} - {errorContent}";
                _lastResultSeverity = Severity.Error;
                Snackbar.Add("Seeding failed!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _lastResult = $"✗ Exception: {ex.Message}";
            _lastResultSeverity = Severity.Error;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSeedLoading = false;
            StateHasChanged();
        }
    }
}
