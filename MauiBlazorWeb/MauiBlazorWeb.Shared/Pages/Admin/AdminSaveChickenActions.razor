@page "/admin/save-chicken-actions"
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenActions
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> L

<PageTitle>@L["Admin_SaveChickenActions_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudText Typo="Typo.h3" Class="mb-4">@L["Admin_SaveChickenActions_Management"]</MudText>

    <MudAlert Severity="Severity.Info" Dense="true" Class="my-4">
        <strong>@L["Admin_Persons_AlertTitle"]</strong> @L["Admin_SaveChickenActions_AlertText"]
    </MudAlert>

    <GenericSearch TDto="SaveChickenActionDto" TSearchDto="SaveChickenActionSearch">
        <SearchForm Context="search">
            <SaveChickenActionSearchForm Model="search" />
        </SearchForm>
        <Table Context="ctx">
            <SaveChickenActionTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
        </Table>
    </GenericSearch>
</MudContainer>
