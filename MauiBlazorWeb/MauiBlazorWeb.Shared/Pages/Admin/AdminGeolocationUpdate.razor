@page "/admin/geolocation-update"
@using MauiBlazorWeb.Shared.Resources.Strings
@using Microsoft.Extensions.Localization
@using System.Text.Json
@using System.Text
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppResources> L

<PageTitle>@L["Admin_Geolocation_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h3" Class="mb-4">@L["Admin_Geolocation_Heading"]</MudText>

        <MudAlert Severity="Severity.Info" Dense="true" Class="my-4">
            @L["Admin_Geolocation_Description"]
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_batchSize" Label="@L["Admin_Geolocation_BatchSize"]" Min="1" Max="100" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSwitch @bind-Value="_updateAll" Label="@L["Admin_Geolocation_UpdateAll"]" Color="Color.Primary" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        @if (_totalCount >= 0)
        {
            <MudText Typo="Typo.h6" Class="mb-2">@L["Admin_Geolocation_Progress"]</MudText>
            <MudProgressLinear Color="Color.Primary" Value="@_progressPercentage" Class="mb-2" />
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Admin_Geolocation_ProcessedLabel"]: @_totalProcessed / @_totalCount (@_progressPercentage.ToString("F1")%)
            </MudText>

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.body2" Color="Color.Success">
                            <strong>@L["Admin_Geolocation_Updated"]:</strong> @_totalUpdated
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.body2" Color="Color.Error">
                            <strong>@L["Admin_Geolocation_Failed"]:</strong> @_totalFailed
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.body2" Color="Color.Info">
                            <strong>@L["Admin_Geolocation_Remaining"]:</strong> @(_totalCount - _totalProcessed)
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_failedPersonIds.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4" Dense="true">
                    <strong>@L["Admin_Geolocation_FailedIds"]:</strong> @string.Join(", ", _failedPersonIds)
                </MudAlert>
            }
        }

        <MudButton
            Variant="Variant.Filled"
            Color="Color.Primary"
            OnClick="StartBatchUpdate"
            Disabled="@_isProcessing"
            Class="mt-4"
            FullWidth="true">
            @if (_isProcessing)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <span>@L["Admin_Geolocation_Processing"]...</span>
            }
            else
            {
                <span>@L["Admin_Geolocation_StartButton"]</span>
            }
        </MudButton>

        @if (_isComplete)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">
                @L["Admin_Geolocation_Complete"]
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">
                @_errorMessage
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isProcessing = false;
    private bool _isComplete = false;
    private int _batchSize = 10;
    private bool _updateAll = false;
    private int _totalCount = -1;
    private int _totalProcessed = 0;
    private int _totalUpdated = 0;
    private int _totalFailed = 0;
    private List<int> _failedPersonIds = new();
    private string _errorMessage = string.Empty;
    private double _progressPercentage => _totalCount > 0 ? (_totalProcessed * 100.0 / _totalCount) : 0;

    private async Task StartBatchUpdate()
    {
        _isProcessing = true;
        _isComplete = false;
        _totalProcessed = 0;
        _totalUpdated = 0;
        _totalFailed = 0;
        _totalCount = -1;
        _failedPersonIds.Clear();
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var skip = 0;
            var hasMore = true;

            while (hasMore)
            {
                var request = new
                {
                    BatchSize = _batchSize,
                    Skip = skip,
                    UpdateAll = _updateAll
                };

                var json = JsonSerializer.Serialize(request);
                var content = new StringContent(json, Encoding.UTF8, "application/json");

                var response = await Http.PostAsync("api/person/batch-update-geolocation", content);

                if (response.IsSuccessStatusCode)
                {
                    var resultJson = await response.Content.ReadAsStringAsync();
                    var result = JsonSerializer.Deserialize<GeolocationBatchUpdateResult>(resultJson, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                    if (result != null)
                    {
                        if (_totalCount < 0)
                        {
                            _totalCount = result.TotalCount;
                        }

                        _totalProcessed += result.ProcessedCount;
                        _totalUpdated += result.UpdatedCount;
                        _totalFailed += result.FailedCount;
                        _failedPersonIds.AddRange(result.FailedPersons);

                        StateHasChanged();

                        if (result.ProcessedCount < _batchSize || _totalProcessed >= _totalCount)
                        {
                            hasMore = false;
                        }
                        else
                        {
                            skip += _batchSize;
                            // Small delay to avoid overwhelming the API
                            await Task.Delay(500);
                        }
                    }
                    else
                    {
                        hasMore = false;
                    }
                }
                else
                {
                    _errorMessage = $"Error: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}";
                    hasMore = false;
                }
            }

            _isComplete = true;
            Snackbar.Add(L["Admin_Geolocation_SuccessMessage"], Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Exception: {ex.Message}";
            Snackbar.Add(L["Admin_Geolocation_ErrorMessage"], Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private class GeolocationBatchUpdateResult
    {
        public int TotalCount { get; set; }
        public int ProcessedCount { get; set; }
        public int UpdatedCount { get; set; }
        public int FailedCount { get; set; }
        public List<int> FailedPersons { get; set; } = new();
    }
}
