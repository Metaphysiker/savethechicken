@page "/admin/save-chicken-requests"
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenRequests
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl

<PageTitle>Admin - Save Chicken Requests Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <h2>Admin - Save Chicken Requests Management</h2>

    <MudAlert Severity="Severity.Info" Dense="true" Class="my-4">
        <strong>Admin Mode:</strong> Manage all chicken save requests. Edit existing requests and link them to existing persons.
    </MudAlert>

    <GenericSearch TDto="SaveChickenRequestDto" TSearchDto="SaveChickenRequestSearch">
        <SearchForm Context="search">
            <SaveChickenRequestSearchForm Model="search" />
        </SearchForm>
        <Table Context="ctx">
            <SaveChickenRequestTable items="ctx.Item1" OnItemSelected="ctx.Item2" OnSortSelected="ctx.Item3" OnItemsChanged="ctx.Item4.InvokeAsync" />
        </Table>
    </GenericSearch>
</MudContainer>
