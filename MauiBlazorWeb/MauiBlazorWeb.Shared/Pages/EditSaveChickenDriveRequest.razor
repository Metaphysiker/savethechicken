@page "/admin/save-chicken-drive-requests/{Id:int}/edit"
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenDriveRequests
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenRequests
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using global::Shared.Dtos.DtosImpl
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@using MudBlazor
@inject GenericDtoServiceFactory DtoServiceFactory
<MudContainer>
<h2>Edit SaveChickenDriveRequest</h2>

@if (modelWithFiles != null)
{
    <GenericUpdateWithFiles TDto="SaveChickenDriveRequestDto" model="modelWithFiles">
        <ChildContent Context="editModel">
            <SaveChickenDriveRequestFormWithFiles EntityWithFiles="editModel" />
        </ChildContent>
    </GenericUpdateWithFiles>
}
else
{
    <p>Loading...</p>
}
</MudContainer>
@code {
    [Parameter] public int Id { get; set; }
    private SaveChickenDriveRequestDto? model = null;
    private ItemWithBrowserFiles<SaveChickenDriveRequestDto>? modelWithFiles = null;

    private GenericDtoService<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>? _service;

    protected override async Task OnInitializedAsync()
    {
        _service = DtoServiceFactory.Create<SaveChickenDriveRequestDto, SaveChickenDriveRequestSearch>();
        model = await _service.GetByIdAsync(Id);
        modelWithFiles = new ItemWithBrowserFiles<SaveChickenDriveRequestDto>
        {
            Item = model,
            Files = new List<IBrowserFile>()
        };
        StateHasChanged();
    }

}
