@using MauiBlazorWeb.Shared.Components.ComponentsImpl
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenDriveRequests
@using MauiBlazorWeb.Shared.Components.ComponentsImpl.SaveChickenRequests
@using MauiBlazorWeb.Shared.Factories.FactoriesImpl
@using MauiBlazorWeb.Shared.Services.ServicesImpl
@using MauiBlazorWeb.Web.Services.ServicesImpl
@using MudBlazor
@inject SaveChickenActionService saveChickenActionService;
@using global::Shared.Dtos.DtosImpl

@page "/admin/save-chicken-drive-requests/new"

<PageTitle>Fahrer werden</PageTitle>

<MudContainer>

    <h3>Ich biete mich als Fahrer an</h3>

    @if(newItemWithBrowserFiles != null)
    {
      <GenericCreateWithFiles TDto="SaveChickenDriveRequestDto" model="newItemWithBrowserFiles" ResourceName="admin/save-chicken-drive-requests" >
        <ChildContent Context="model">
            <SaveChickenDriveRequestFormWithFiles EntityWithFiles="model" />
        </ChildContent>
    </GenericCreateWithFiles>
    }


</MudContainer>

@code {
    @code {
        private SaveChickenDriveRequestDto saveChickenDriveRequestDto = new();
        private ItemWithBrowserFiles<SaveChickenDriveRequestDto>? newItemWithBrowserFiles;

        protected override async Task OnInitializedAsync()
        {
            SaveChickenActionDto? activeSaveChickenAction = await saveChickenActionService.GetActiveSaveChickenAction();

            if (activeSaveChickenAction != null)
            {
                saveChickenDriveRequestDto.SaveChickenActionId = activeSaveChickenAction?.Id;
            }

            newItemWithBrowserFiles = new ItemWithBrowserFiles<SaveChickenDriveRequestDto>
            {
                Item = saveChickenDriveRequestDto,
                Files = new List<IBrowserFile>()
            };

            newItemWithBrowserFiles.Item = saveChickenDriveRequestDto;
        }
    }
}
