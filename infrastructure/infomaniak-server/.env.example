# Production Environment Configuration Template
# Copy this to .env and fill in your production values

# Server ports
PORT_FRONTEND=8090
PORT_WEBAPI=8091

# Public API URL (must be accessible from client browsers)
API_BASE_URL=https://your-api-domain.com/

# Database password (use strong random password)
POSTGRES_PASSWORD=change-me-to-strong-random-password

# Admin user password
ADMIN_PASSWORD=change-me-to-strong-admin-password

# Special user password
RETTET_DAS_HUHN_PASSWORD=change-me-to-strong-password

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=eu-central-1
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=your-production-bucket-name

# JWT Signing Key (minimum 32 characters, use random string)
# Generate with: openssl rand -base64 32
SIGNING_KEY=change-me-to-random-32-plus-char-string
